#--------------------------------------------------------------------------
# Project platform
#--------------------------------------------------------------------------
DENV_PLATFORM=magento2

#--------------------------------------------------------------------------
# Service settings
#--------------------------------------------------------------------------
DENV_SEARCH_ENGINE=1     # For elasticsearch/opensearch
DENV_ADMINER=1
DENV_HTTPD=0             # Same as apache2
DENV_VARNISH=0
DENV_CRON=1
DENV_REDIS=0
DENV_MEMCACHED=0         # Need add memcached to PHP_EXTENSIONS_ENABLE when enable
DENV_RABBITMQ=0
DENV_ZOOKEEPER=0         # Need add zookeeper to PHP_EXTENSIONS_ENABLE when enable
DENV_MFTF=0
DENV_INTEGRATION=0
DENV_NEWRELIC=0          # Need add newrelic to PHP_EXTENSIONS_ENABLE when enable
DENV_TIDEWAYS=0          # Need add tideways to PHP_EXTENSIONS_ENABLE when enable
DENV_NGROK=0
DENV_VSCODE=1
DENV_BROWSER_SYNC=0
DENV_BLACKFIRE=0         # Need add blackfire to PHP_EXTENSIONS_ENABLE when enable
DENV_XHPROF=0            # Need add xhprof to PHP_EXTENSIONS_ENABLE when enable

#--------------------------------------------------------------------------
# Define the prefix of container names.
# This is useful if you have multiple projects that use docker
# to have separate containers per project.
#--------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=m247

#--------------------------------------------------------------------------
# Website URL
# Multiple URL separated by a space.
#--------------------------------------------------------------------------
VIRTUAL_HOST=m247.test

#--------------------------------------------------------------------------
# Fake IP
#--------------------------------------------------------------------------
FAKE_IP_ENABLE=false
FAKE_IP_ADDRESS=1.1.1.1

#--------------------------------------------------------------------------
# List module enable for nginx container.
# Check module name in /etc/nginx/modules/ inside nginx container.
#--------------------------------------------------------------------------
NGINX_MODULES_ENABLE=ngx_http_image_filter_module

#--------------------------------------------------------------------------
# Supported PHP extensions:
#    amqp apcu blackfire bz2 elastic_apm excimer gettext imagick imap ioncube
#    ldap lz4 mailparse mcrypt memcached mongodb mysqli newrelic oauth
#    pcov pdo_dblib pdo_pgsql pdo_sqlsrv pgsql shmop sourceguardian
#    spx sqlsrv ssh2 swoole tideways tidy uploadprogress xdebug xhprof xmlrpc
#    zookeeper yaml
#
# Example: PHP_EXTENSIONS_ENABLE=imagick ioncube mysqli
#--------------------------------------------------------------------------
PHP_EXTENSIONS_ENABLE=imagick

#--------------------------------------------------------------------------
# Select a PHP version of PHP-FPM and CLI containers.
# Accepted values: 5.6 -> 8.4
#--------------------------------------------------------------------------
PHP_VERSION=8.3

#--------------------------------------------------------------------------
# PHP Performance Profiling
#--------------------------------------------------------------------------
XDEBUG_REMOTE_HOST=host.docker.internal

# newrelic.license: Paste value to ~/.denv/secrets/newrelic_license.txt
# tideways.api_key: Paste value to ~/.denv/secrets/tideways_api_key.txt
# BLACKFIRE_SERVER_ID: Paste value to ~/.denv/secrets/blackfire_server_id.txt
# BLACKFIRE_SERVER_TOKEN: Paste value to ~/.denv/secrets/blackfire_server_token.txt
# BLACKFIRE_CLIENT_ID: Paste value to ~/.denv/secrets/blackfire_client_id.txt
# BLACKFIRE_CLIENT_TOKEN: Paste value to ~/.denv/secrets/blackfire_client_token.txt

#--------------------------------------------------------------------------
# Select a composer version of CLI containers.
# Accepted values: 2.8 - 2.7 - 2.2 - 2.1 - 2 - 1
#--------------------------------------------------------------------------
COMPOSER_VERSION=2.8

#--------------------------------------------------------------------------
# Database Server
# Accepted values: mysql - mariadb - percona
#--------------------------------------------------------------------------
DATABASE_ENGINE=mariadb
DATABASE_ENGINE_VERSION=10.6
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=magento
MYSQL_PASSWORD=magento
MYSQL_DATABASE=magento
MYSQL_INNODB_BUFFER_POOL_SIZE=512M

#--------------------------------------------------------------------------
# Search Engine
# Accepted values: elasticsearch - opensearch
#--------------------------------------------------------------------------
SEARCH_ENGINE=opensearch
SEARCH_ENGINE_VERSION=2.12
ES_JAVA_OPTS=-Xms512m -Xmx512m

#--------------------------------------------------------------------------
# Varnish
#--------------------------------------------------------------------------
VARNISH_VERSION=7.5
VARNISH_SIZE=512M

#--------------------------------------------------------------------------
# RabbitMQ
#--------------------------------------------------------------------------
RABBITMQ_VERSION=3.13
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

#--------------------------------------------------------------------------
# Redis
#--------------------------------------------------------------------------
REDIS_VERSION=7.2
REDIS_MAX_MEMORY=512mb

#--------------------------------------------------------------------------
# Selenium automates browsers
# Accepted values: chrome - chromium
# Use `chromium` for chip ARM.
#--------------------------------------------------------------------------
SELENIUM_BROWSER=chromium

#--------------------------------------------------------------------------
# Allure Report
# Point to the path test results of your project code on your host.
# Uncomment what you want to use.
#--------------------------------------------------------------------------
# ALLURE_UNIT_TEST_RESULT_DIR=${WORK_DIR}/dev/tests/unit/var/allure-results/
# ALLURE_INTEGRATION_TEST_RESULT_DIR=${WORK_DIR}/dev/tests/integration/var/allure-results/
# ALLURE_MFTF_TEST_RESULT_DIR=${WORK_DIR}/dev/tests/acceptance/tests/_output/allure-results/

#--------------------------------------------------------------------------
# List address blocked outbound connections
# Accepted values: URL or IP address
#--------------------------------------------------------------------------
BLOCK_OUTBOUND="smtp.gmail.com
                smtp.office365.com
                smtp.sendgrid.net
                smtp.mailgun.org
                smtp-relay.brevo.com
                smtp.zoho.com
                ssl0.ovh.net
                in-v3.mailjet.com
                smtp.postmarkapp.com
                r1-smtp.dotdigital.com
                r2-smtp.dotdigital.com
                r3-smtp.dotdigital.com
                smtp.mandrillapp.com"

#--------------------------------------------------------------------------
# Ngrok Tunnel Authtokens
# https://ngrok.com/docs/secure-tunnels/ngrok-agent/tunnel-authtokens/
#
# Paste token to ~/.denv/secrets/ngrok_token.txt
#--------------------------------------------------------------------------
