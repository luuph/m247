            <argument name="providers" xsi:type="array">
                <item name="giftcard_options" xsi:type="object">Bss\GiftCardGraphQl\Model\Cart\BuyRequest\BssGiftCardDataProvider</item>
            </argument>
        </arguments>
    </type>
</config>
