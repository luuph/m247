<?php
namespace Magecomp\Whatsappcountryflag\Helper;

use Magento\Store\Model\ScopeInterface;

class Data extends \Magento\Framework\App\Helper\AbstractHelper
{
    const ENABLED = 'whatsappultimate/whatsappcountryflag/enable';
    const DETECT_BY_IP = 'whatsappultimate/whatsappcountryflag/detect_by_ip';
    const DETECT_BY_DEFAULT_COUNTRY = 'whatsappultimate/whatsappcountryflag/defaultcountry';
    const COUNTRY_CODE_PATH = 'general/country/default';
    const COUNTRY_VALIDATION = 'whatsappultimate/whatsappcountryflag/countryvalidate';
    const WHATSAPP_GENERAL_ENABLED = 'whatsappultimate/general/enable';
    const WHATSAPP_MOBILE_MINDIGITS = 'whatsappultimate/whatsappcountryflag/mindigits';
    const WHATSAPP_MOBILE_MAXDIGITS = 'whatsappultimate/whatsappcountryflag/maxdigits';

    protected $remoteaddress;
    protected $resolver;
    protected $_storeManager;
    protected $jsonHelper;
    protected $httpFile;
    protected $country;

    public function __construct(
        \Magento\Framework\App\Helper\Context $context,
        \Magento\Framework\HTTP\PhpEnvironment\RemoteAddress $remoteaddress,
        \Magento\Framework\Locale\Resolver $resolver,
        \Magento\Store\Model\StoreManagerInterface $storeManager,
        \Magento\Framework\Json\Helper\Data $jsonHelper,
        \Magento\Framework\Filesystem\Driver\Http $httpFile,
        \Magecomp\Whatsappcountryflag\Model\Config\Source\Country $country
    ) {
        $this->_storeManager = $storeManager;
        $this->remoteaddress = $remoteaddress;
        $this->resolver = $resolver;
        $this->jsonHelper = $jsonHelper;
        $this->httpFile = $httpFile;
        $this->country = $country;
        parent::__construct($context);
    }

    public function getStoreid()
    {
        return $this->_storeManager->getStore()->getId();
    }
    public function isMainEnabled($storeid = Null)
    {
        return $this->scopeConfig->getValue(
            self::WHATSAPP_GENERAL_ENABLED,
            ScopeInterface::SCOPE_STORE,
            $storeid
        );
    }
    public function isEnabled($storeid = Null)
    {
        return $this->scopeConfig->getValue(
            self::ENABLED,
            ScopeInterface::SCOPE_STORE,
             $storeid
        );
    }
    
    public function getDetectByIp($storeid = Null)
    {
        return $this->scopeConfig->getValue(
            self::DETECT_BY_IP,
            ScopeInterface::SCOPE_STORE,
            $storeid
        );
    }

    public function getDefualtCountry($storeid = Null)
    {
        return $this->scopeConfig->getValue(
            self::DETECT_BY_DEFAULT_COUNTRY,
            ScopeInterface::SCOPE_STORE,
            $storeid
        );
    }

    public function getDefaultCountryCodeNumber($storeid = Null)
    {
        $countryCode = $this->getDefualtCountry($storeid);
        return $this->getCountryCode($countryCode);
    }

    public function getTemplate($storeid = Null)
    {
        if ($this->isEnabled($storeid) && $this->isMainEnabled($storeid)) {
            $template = 'Magecomp_Whatsappcountryflag::form/edit.phtml';
        } else {
            $template = 'Magento_Customer::address/edit.phtml';
        }
        return $template;
    }

    public function getCustomerIPAddress($storeid = Null)
    {
        $local = ($_SERVER['REMOTE_ADDR'] == '127.0.0.1' || $_SERVER['REMOTE_ADDR'] == '::1') ? true : false;
        if ($local) {
            return '8.8.8.8';
        }else{
        	return $_SERVER['HTTP_X_FORWARDED_FOR']!=""?$_SERVER['HTTP_X_FORWARDED_FOR']:$this->remoteaddress->getRemoteAddress();
        }
        
        return $this->remoteaddress->getRemoteAddress();
    }

    public function getCustomerIPDetails($storeid = Null)
    {
        $customerIpAddress = $this->getCustomerIPAddress($storeid);
        try {
            $ipData = $this->jsonHelper->jsonDecode(
                $this->httpFile->fileGetContents(
                    "www.geoplugin.net/json.gp?ip=" . $customerIpAddress
                )
            );
            return $ipData['geoplugin_countryCode'];
        } catch (\Exception $e) {
            return $this->scopeConfig->getValue(
                self::COUNTRY_CODE_PATH,
                ScopeInterface::SCOPE_WEBSITES
            );
        }
    }

    public function getCountryvalidation($code,$storeid = Null)
    {
        $digit='';
        $validation = $this->scopeConfig->getValue(self::COUNTRY_VALIDATION, ScopeInterface::SCOPE_STORE, $storeid);
        $validation_array = json_decode($validation, true);
            $validation_value = array_values($validation_array);
        if ($this->isEnabled($storeid) && count($validation_value)>0) {
            $validation_value = $this->arraychange($validation_value);
        
            foreach ($validation_value as $key => $value) {
                if ($value['country'] == strtoupper($code)) {
                     $digit = $value['digit'];
                     return $digit;
                } elseif ($value['country'] == 1) {
                    $digit = $value['digit'];
                    return $digit;
                }
            }
        } else {
            return false;
        }
    }
    
    public function arraychange($array)
    {
        foreach ($array as $key => $val) {
            if ($val["country"] == 1) {
                $item = $array[$key];
                unset($array[$key]);
                array_push($array, $item);
                break;
            }
        }
        return $array;
    }

    // public function getCountryList()
    // {
    //     $countryArray = $this->country->toOptionArray();
    //     return $countryArray;
    // }

    public function getCountryList()
    {
        $countryArray = $this->country->toOptionArray(); 
        $countryCodes = $this->getCountryCodeData();

        foreach ($countryArray as &$country) {
            $countryCode = $countryCodes[$country['value']] ?? null;
            $country['country_code'] = $countryCode;
        }

        return $countryArray;
    }

