<div class="field required">
    <div class="control">
        <input type="checkbox" id="terms" name="terms" <?php if ($block->getCustomerWpterms()) {?> checked="checked" <?php }?> data-validate="{required:false}" class="input-checkbox checkbox required" value="1">
