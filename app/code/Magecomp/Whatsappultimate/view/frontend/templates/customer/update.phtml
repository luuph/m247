<?php if ($block->getCustomerMobile() != ''): ?>
<div id="existingnumberdiv">
    <p class="empty"></p>
</div>
<?php endif; ?>
<script>
    require(['jquery', 'jquery/ui','Magecomp_Whatsappultimate/countryflag/js/intlTelInput.min'], function($)
    {
        <?php if ($block->getCustomerMobile()): ?>
           var mobileno = "<?= /* @noEscape*/ $block->getCustomerMobile()  ?>"; 
           var phone = mobileno.toString(); 
           var prefixLength = 2;
           var suffixLength = 2;
           var prefix  = phone.substring(0, prefixLength);
           var suffix  = phone.slice(-suffixLength);
           var nbStars = phone.length - (prefixLength + suffixLength);
           formattedPhone = prefix + "x".repeat(nbStars) + suffix;
           $("#existingnumberdiv .empty").text('Make Sure, Your Existing Verified Number is : '+formattedPhone+' Available on WhatsApp.');
        <?php endif; ?>
        $(document).ready(function()
        {
            $("#mobilenumber").val("");
        });
        function Smsresetdata()
        {
            $('#mobilenumber').removeClass('mage-error');
            $('#otp').removeClass('mage-error');
            $('#smserrordiv').hide();
            $('#smserrordiv').html('');
            $('#smserror').html('');
        }

        function Smstoggeldata(Elementid)
        {
            $(Elementid).toggle();
        }
        $("#terms").change(function(e)
        {
            var wpterms = 0;
            if(this.checked){
                var wpterms = 1;
            }
            
            $.ajax({
                    type: "POST",
                    url: '<?= /* @noEscape*/ $block->getUrl('whatsappultimate/customer/wpterms')?>',
                    data:{'wpterms':wpterms}
            });
        })

             <?php if ($block->getCountryFlagEnable()) { ?>
                 $("#getotpbtn").prop("disabled", true);
                var country_flag = "<?= /* @noEscape*/ $block->getDefaultContry();?>";
                    <?php if ($block->getCountryFlagDetectByIP()):?>
                    country_flag = "<?= /* @noEscape*/ $block->getGeoCountryCode();?>";
                <?php endif; ?>
                $("#mobilenumber").intlTelInput({
                    initialCountry: country_flag,
                    utilsScript: "<?= /* @noEscape*/ $block->getViewFileUrl('Magecomp_Whatsappultimate::countryflag/js/utils.js'); ?>"
                });

                $(".country-list li").on('click', function() {
                    $("#mobilenumber").val("");
                    jQuery("#getotpbtn").prop("disabled", true);
                    jQuery("#mobilenumber").attr('maxlength',12);
                });
                
                 $("#mobilenumber").keyup(function(){
                    Smsresetdata();
                    var str = $(".selected-flag").attr("title");
                    var countrycode =  str.split('+')[1];
                    var countrycodeval =  str.split('+')[1];
                    var mobilelength=$('#mobilenumber').val().length;
                    var mobile = countrycode+$('#mobilenumber').val();
                    $("#countryreg").val(countrycode);
                    var temp=true;
                    if(mobile == null || mobile == '')
                    {
                        temp=false;
                        $('#mobilenumber').addClass('mage-error');
                        $('#smserror').html('<?= /* @noEscape*/ __('This is a required field.') ?>');
                        return false;
                    }
                    if(!$.isNumeric(mobile) || mobile.substring(0,1)=='+' || mobile.substring(0,1)=='-')
                    {
                        temp=false;
                        $('#mobilenumber').addClass('mage-error');
                        $('#smserror').html('<?= /* @noEscape*/ __('Make sure, you have entered valid WhatsApp Number.') ?>');
                        return false;
                    }
                    var countrycode = jQuery(".flag-container > .country-list > .active").attr("data-country-code");

                    $.ajax({
                        type: "POST",
                        url: '<?= /* @noEscape*/ $block->getUrl('whatsappcountryflag/customer/validatephone')?>',
                        data:{'mobile':mobile,'countrycode':countrycode,'mobilelength':mobilelength,'country_id':countrycodeval},
                        success: function(data)
                        {
                            jQuery("#mobilenumber").attr('maxlength',data.digit);
                            if(data.validate==true){
                                $('#smserror').html('<?= /* @noEscape*/ __('') ?>');
                                $("#getotpbtn").prop("disabled", false);
                            }
                            else{
                                if(temp==true){
                                    $('#smserror').html(data.message);
                                }
                                $("#getotpbtn").prop("disabled", true);
                            }
                        },
                        error: function(data) {
                            $('#smserror').html('<?= /* @noEscape*/ __('Something went wrong, Try again later.') ?>');/* @noEscape*/
                        }
                    });
                });

                $("#getotpbtn").click(function(e)
                {

                    //Reset Everything
                    Smsresetdata();

                    //Number Validation
                    var str = jQuery(".selected-flag").attr("title");
                    var countrycode =   str.split('+')[1];
                    var mobile = countrycode+$('#mobilenumber').val();
                    var mobilelength=$('#mobilenumber').val().length;
                    if(mobile == null || mobile == '')
                    {
                        $('#mobilenumber').addClass('mage-error');
                        $('#smserrordiv').show();
                        $('#smserrordiv').html('<?= /* @noEscape*/__('Please, First Enter Your WhatsApp Number.') ?>');
                        return false;
                    }
                    
                    var countrycode = jQuery(".flag-container > .country-list > .active").attr("data-country-code");
                    if(!$.isNumeric(mobile) || mobile.substring(0,1)=='+' || mobile.substring(0,1)=='-')
                    {
                            $('#mobilenumber').addClass('mage-error');
                             $('#smserrordiv').show();
                            $('#smserrordiv').html('<?= /* @noEscape*/__('Make sure, you have entered valid WhatsApp Number.') ?>');
                            return false;
                    }
                    var wpterms = 0;
                    if($("#terms").is(':checked')) {
                         wpterms = 1;
                    }
                    

                    //Send OTP To Number
                    $.ajax({
                        type: "POST",
                        url: '<?= /* @noEscape*/$block->getUrl('whatsappultimate/customer/updateotp')?>',
                        data:{'mobile':mobile,'countrycode':countrycode,'mobilelength':mobilelength,'wpterms':wpterms},
                        beforeSend: function()
                        {
                            Smsresetdata();
                            Smstoggeldata('#getotpbtn');
                            Smstoggeldata('#waitsmsdiv');
                        },
                        success: function(data)
                        {
                            if(data.validate==false)
                                {
                                Smstoggeldata('#waitsmsdiv');
                                Smstoggeldata('#getotpbtn');
                                $('#smserrordiv').show();
                                $('#smserrordiv').html(data.message);
                                }
                            else{
                                if(data == 'success')
                                {
                                    Smstoggeldata('#waitsmsdiv');
                                    Smstoggeldata('#otpdiv');
                                    Smstoggeldata('#resendotpbtn');
                                    Smstoggeldata('#confirmationdiv');
                                    $('#mobilenumber').attr('readonly', true);
                                }
                                else
                                {
                                    Smstoggeldata('#waitsmsdiv');
                                    Smstoggeldata('#getotpbtn');
                                    $('#smserrordiv').show();
                                    $('#smserrordiv').html(data);
                                }
                            }
                        },
                        error: function() {
                            Smstoggeldata('#waitsmsdiv');
                            Smstoggeldata('#getotpbtn');
                            $('#smserrordiv').show();
                            $('#smserrordiv').html('<?= /* @noEscape*/__('Something Went Wrong, Try Again Later.') ?>');
                        }
                    });
                });

                $("#resendotpbtn").click(function(e)
                {
                    //Reset Everything
                    Smsresetdata();

                    var str = jQuery(".selected-flag").attr("title");
                        var countrycode =   str.split('+')[1];
                        var mobile = countrycode+$('#mobilenumber').val();
                        var wpterms = 0;
                    if($("#terms").is(':checked')) {
                         wpterms = 1;
                    }
                    //Re-Send OTP To Number
                    $.ajax({
                        type: "POST",
                        url: '<?= /* @noEscape*/$block->getUrl('whatsappultimate/customer/updateotp')?>',
                        data:{'mobile':mobile,'wpterms':wpterms},
                        beforeSend: function()
                        {
                            Smsresetdata();
                            Smstoggeldata('#resendotpbtn');
                            Smstoggeldata('#waitsmsdiv');
                            Smstoggeldata('#confirmationdiv');
                        },
                        success: function(data)
                        {
                            Smstoggeldata('#waitsmsdiv');
                            Smstoggeldata('#confirmationdiv');
                            if(data != 'success')
                            {
                                $('#smserrordiv').show();
                                $('#smserrordiv').html(data);
                            }
                        },
                        error: function() {
                            Smstoggeldata('#waitsmsdiv');
                            $('#smserrordiv').show();
                            $('#smserrordiv').html('<?= /* @noEscape*/__('Something Went Wrong, Try Again Later.') ?>');
                        }
                    });
                });
    <?php } else {?>
    
             $("#getotpbtn").click(function(e)
                {
                    //Reset Everything
                    Smsresetdata();

                    //Number Validation
                    var mobile = $('#mobilenumber').val();
                    if(mobile == null || mobile == '')
                    {
                        $('#mobilenumber').addClass('mage-error');
                        $('#smserrordiv').show();
                        $('#smserrordiv').html('<?= /* @noEscape*/ __('Please, First Enter Your WhatsApp Number.') ?>');
                        return false;
                    }
                    if(!$.isNumeric(mobile) || mobile.length <= 9)
                    {
                        $('#mobilenumber').addClass('mage-error');
                        $('#smserrordiv').show();
                        $('#smserrordiv').html('<?= /* @noEscape*/ __('Make sure, you have entered valid WhatsApp Number.') ?>');
                        return false;
                    }
                    var wpterms = 0;
                    if($("#terms").is(':checked')) {
                         wpterms = 1;
                    }
                    

                    //Send OTP To Number
                    $.ajax({
                        type: "POST",
                        url: '<?= /* @noEscape*/ $block->getUrl('whatsappultimate/customer/updateotp')?>',
                        data:{'mobile':mobile,'wpterms':wpterms},
                        //data:{'mobile':mobile,'otpin':otpin},
                        beforeSend: function()
                        {
                            Smsresetdata();
                            Smstoggeldata('#getotpbtn');
                            Smstoggeldata('#waitsmsdiv');
                        },
                        success: function(data)
                        {
                            if(data == 'success')
                            {
                                Smstoggeldata('#waitsmsdiv');
                                Smstoggeldata('#otpdiv');
                                Smstoggeldata('#resendotpbtn');
                                Smstoggeldata('#confirmationdiv');
                                $('#mobilenumber').attr('readonly', true);
                            }
                            else
                            {
                                Smstoggeldata('#waitsmsdiv');
                                Smstoggeldata('#getotpbtn');
                                $('#smserrordiv').show();
                                $('#smserrordiv').html(data);
                            }
                        },
                        error: function() {
                            Smstoggeldata('#waitsmsdiv');
                            Smstoggeldata('#getotpbtn');
                            $('#smserrordiv').show();
                            $('#smserrordiv').html('<?= /* @noEscape*/ __('Something Went Wrong, Try Again Later.') ?>');
                        }
                    });
                });

                $("#resendotpbtn").click(function(e)
                {
                    //Reset Everything
                    Smsresetdata();

                    var mobile = $('#mobilenumber').val();
                    var countrycode = $("#countryreg").val();
                    mobile = countrycode.concat(mobile);
                    var wpterms = 0;
                    if($("#terms").is(':checked')) {
                         wpterms = 1;
                    }

                    //Re-Send OTP To Number
                    $.ajax({
                        type: "POST",
                        url: '<?= /* @noEscape*/ $block->getUrl('whatsappultimate/customer/updateotp')?>',
                        data:{'mobile':mobile,'wpterms':wpterms},
                        beforeSend: function()
                        {
                            Smsresetdata();
                            Smstoggeldata('#resendotpbtn');
                            Smstoggeldata('#waitsmsdiv');
                            Smstoggeldata('#confirmationdiv');
                        },
                        success: function(data)
                        {
                            Smstoggeldata('#waitsmsdiv');
                            Smstoggeldata('#confirmationdiv');
                            if(data != 'success')
                            {
                                $('#smserrordiv').show();
                                $('#smserrordiv').html(data);
                            }
                        },
                        error: function() {
                            Smstoggeldata('#waitsmsdiv');
                            $('#smserrordiv').show();
                            $('#smserrordiv').html('<?= /* @noEscape*/ __('Something Went Wrong, Try Again Later.') ?>');
                        }
                    });
                });
    <?php } ?>
        $("#confirmotpbtn").click(function(e)
        {
            //OTP Validation
            var otpstring = $('#otp').val();
            if(otpstring == null || otpstring == '')
            {
                $('#otp').addClass('mage-error');
                $('#smserrordiv').show();
                $('#smserrordiv').html('<?= /* @noEscape*/ __('Please Enter OTP') ?>');
                return false;
            }

            var mobile = $('#mobilenumber').val();
             <?php if ($block->getCountryFlagEnable()) { ?>
                var countrycode = $("#countryreg").val();
                mobile = countrycode.concat(mobile);
             <?php } ?> 
            var wpterms = 0;
            if($("#terms").is(':checked')) {
                 wpterms = 1;
            }

            //Verify Mobile & OTP
            $.ajax({
                type: "POST",
                url: '<?= /* @noEscape*/ $block->getUrl('whatsappultimate/customer/updateotpnumber')?>',
                data:{'mobile':mobile,'otp':otpstring,'wpterms':wpterms},
                beforeSend: function()
                {
                    Smsresetdata();
                    Smstoggeldata('#otpbtndiv');
                    Smstoggeldata('#waitsmsdiv');
                    Smstoggeldata('#confirmationdiv');
                },
                success: function(data)
                {
                    Smstoggeldata('#waitsmsdiv');
                    if(data == 'success')
                    {
                        $('#smssuccessdiv').html('<?= /* @noEscape*/ __('Your WhatsApp Number is Verified Successfully!') ?>'); 
                        $('#smssuccessdiv').show();
                        setTimeout(function () {
                            location.reload();
                        }, 2000);
                    }
                    else
                    {
                        $('#smserrordiv').html(data);
                        Smstoggeldata('#smserrordiv');
                        Smstoggeldata('#confirmationdiv');
                    }
                },
                error: function() {
                    Smstoggeldata('#waitsmsdiv');
                    Smstoggeldata('#confirmationdiv');
                    $('#smserrordiv').html('<?= /* @noEscape*/__('Something Went Wrong, Try Again Later.') ?>');
                    Smstoggeldata('#smserrordiv');
                }
            });
        });

    });
</script>
