<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="admin-2columns-left" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Mageplaza\Affiliate\Block\Adminhtml\Campaign\Edit" name="mageplaza_affiliate_campaign_edit"/>
        </referenceContainer>
        <referenceContainer name="left">
            <block class="Mageplaza\Affiliate\Block\Adminhtml\Campaign\Edit\Tabs" name="mageplaza_affiliate_campaign_tabs">
                <block class="Mageplaza\Affiliate\Block\Adminhtml\Campaign\Edit\Tab\Campaign"
                       name="mageplaza_affiliate_campaign_edit_tab_campaign">
                    <block class="Mageplaza\Affiliate\Block\Adminhtml\Campaign\Edit\Tab\Campaign\Information"
                           name="mageplaza_affiliate_campaign_edit_tab_campaign_information"/>
                    <block class="Mageplaza\Affiliate\Block\Adminhtml\Campaign\Edit\Tab\Campaign\ReferralLink"
                           name="mageplaza_affiliate_campaign_edit_tab_renfer_link"/>
                </block>
                <block class="Mageplaza\Affiliate\Block\Adminhtml\Campaign\Edit\Tab\Condition" name="mageplaza_affiliate_campaign_edit_tab_condition"/>
                <block class="Mageplaza\Affiliate\Block\Adminhtml\Campaign\Edit\Tab\Actions"
                       name="mageplaza_affiliate_campaign_edit_tab_actions">
                    <block class="Mageplaza\Affiliate\Block\Adminhtml\Campaign\Edit\Tab\Actions\Action"
                           name="mageplaza_affiliate_campaign_edit_tab_action"/>
                    <block class="Mageplaza\Affiliate\Block\Adminhtml\Campaign\Edit\Tab\Actions\Discount"
                           name="mageplaza_affiliate_campaign_edit_tab_coupon_code"/>
                    <block class="Mageplaza\Affiliate\Block\Adminhtml\Campaign\Edit\Tab\Actions\Commissions"
                           name="mageplaza_affiliate_campaign_edit_tab_commissions"/>
                </block>
                <action method="addTab">
                    <argument name="name" xsi:type="string">campaign</argument>
                    <argument name="block" xsi:type="string">mageplaza_affiliate_campaign_edit_tab_campaign</argument>
                </action>
                <action method="addTab">
                    <argument name="name" xsi:type="string">condition_section</argument>
                    <argument name="block" xsi:type="string">mageplaza_affiliate_campaign_edit_tab_condition</argument>
                </action>
                <action method="addTab">
                    <argument name="name" xsi:type="string">actions_section</argument>
                    <argument name="block" xsi:type="string">mageplaza_affiliate_campaign_edit_tab_actions</argument>
                </action>
            </block>
        </referenceContainer>
    </body>
</page>
