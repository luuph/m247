/** @var Arraycommission $block */
use Mageplaza\Affiliate\Block\Adminhtml\Campaign\Edit\Tab\Commissions\Arraycommission;

$element        = $block->getElement();
$checkAffiliatePro = (int)$block->checkAffiliatePro();
$checkAffiliateUltimate = (int)$block->checkAffiliateUltimate();
?>
<?php if ($checkAffiliatePro || $checkAffiliateUltimate):?>
    <div id="popup" class="popup">
        <div class="popup-content">
            <div class="action-close"><span>close</span></div>
            <h1 class="model-title" >Attention</h1>
            <p>Please upgrade your version to use this feature. You can upgrade <a href="https://dashboard.mageplaza.com/license/ ">here</a>.</p>
        </div>
    </div>
    <style>
        #popup.popup {
            z-index:1000;
            display: none;
            position: fixed;
            top: 0; right: 0; bottom: 0; left: 0;
            background-color: rgba(0,0,0,0.5);
        }

        #popup .popup-content {
            background-color: #FFFFFF;
            position: fixed;
            top:15%;
            width: 27%;
            height: 15%;
            left:50%;
            transform: translate(-50%, -50%);
        }

        #popup .popup-content p{
            margin-left: 5%;
        }
        #popup .popup-content h1 {
            margin-left: 5%;
            margin-top: 5%;
        }

        .action-close {
            top: 3%;
            right: 1%;
            position: fixed;
            font-size: 1.6rem;
            color: black;
            width: 25px;
        }
    </style>
    <script>
        require([
            'jquery',
        ], function ($) {
            var ultimate = <?= /** @noEscape */ $checkAffiliateUltimate ?>,
                pro = <?= /** @noEscape */ $checkAffiliatePro ?>;
            $('#campaign_pay_commission').on('change',function (){
                if ($('#campaign_pay_commission').val() !== '1' && ultimate) {
                    $('#popup').show();
                    $('#campaign_pay_commission').val(1)
                }
            });
            if (pro) {
                $('#commission-add').click(function (e) {
                    $('#popup').show();
                });
            }

            $('.action-close').click(function(){
                $('#popup').hide();
            });
            $(document).mouseup(function(e) {
                var container = $("#popup");
                if (container.is(e.target) && container.has(e.target).length === 0) {
                    container.hide();
                }
            });
        });
    </script>
<?php endif; ?>
<div class="field" id="attribute-<?= $element->getHtmlId() ?>-container" data-attribute-code="<?= $element->getHtmlId() ?>"
     data-apply-to="<?= $block->escapeHtml(
         $this->helper('Magento\Framework\Json\Helper\Data')->jsonEncode(
             $element->hasEntityAttribute() ? $element->getEntityAttribute()->getApplyTo() : []
         )
     ) ?>">
    <label class="commission-list-label"><span><?= /** @noEscape */ $block->getElement()->getLabel() ?></span></label>
    <div class="control">
        <table class="admin__control-table commission_tiers_table" id="commission_tiers_table">
            <thead>
                <tr>
                    <th class="col-tier-number"><?= /* @escapeNotVerified */ __('Tier') ?></th>
                    <th class="col-1st-order-type"><?= /* @escapeNotVerified */ __('Type (1st Order)') ?></th>
                    <th class="col-1st-value"><?= /* @escapeNotVerified */ __('Value (1st Order)') ?></th>
                    <th class="col-next-order-type"><?= /* @escapeNotVerified */ __('Type (Next orders)') ?></th>
                    <th class="col-next-order-value"><?= /* @escapeNotVerified */ __('Value (Next orders)') ?></th>
                    <?= /** @noEscape */ $block->addExtraTHead() ?>
                </tr>
            </thead>
            <?= /** @noEscape */ $block->getBodyCommission() ?>
        </table>
        <?= $block->addExtraHtml() ?>
    </div>
</div>

