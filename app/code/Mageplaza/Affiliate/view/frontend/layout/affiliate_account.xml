<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="2columns-left" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd" label="Customer My Account (All Pages)" design_abstraction="custom">
    <head>
        <css src="Mageplaza_Affiliate::css/style.css"/>
    </head>
    <body>
        <attribute name="class" value="account"/>
        <referenceBlock name="breadcrumbs">
            <action method="addCrumb">
                <argument name="crumbName" xsi:type="string">Home</argument>
                <argument name="crumbInfo" xsi:type="array">
                    <item name="title" xsi:type="string" translate="true">Home</item>
                    <item name="label" xsi:type="string" translate="true">Home</item>
                    <item name="link" xsi:type="string">/</item>
                </argument>
            </action>
            <action method="addCrumb">
                <argument name="crumbName" xsi:type="string">Account</argument>
                <argument name="crumbInfo" xsi:type="array">
                    <item name="title" xsi:type="string" translate="true">Account</item>
                    <item name="label" xsi:type="string" translate="true">Account</item>
                    <item name="link" xsi:type="string">/customer/account</item>
                </argument>
            </action>
<!--            <action method="addCrumb">-->
<!--                <argument name="crumbName" xsi:type="string">My Affiliate</argument>-->
<!--                <argument name="crumbInfo" xsi:type="array">-->
<!--                    <item name="title" xsi:type="string" translate="true">My Affiliate</item>-->
<!--                    <item name="label" xsi:type="string" translate="true">My Affiliate</item>-->
<!--                    <item name="link" xsi:type="string">/affiliate</item>-->
<!--                </argument>-->
<!--            </action>-->
        </referenceBlock>
        <referenceContainer name="sidebar.main">
            <block class="Magento\Framework\View\Element\Template" name="affiliate_navigation_block" template="Magento_Theme::html/collapsible.phtml" before="-" ifconfig="affiliate/general/enabled">
                <arguments>
                    <argument name="block_title" translate="true" xsi:type="string">Account Dashboard</argument>
                    <argument name="block_css" xsi:type="string">block-collapsible-nav</argument>
                </arguments>
                <block class="Mageplaza\Affiliate\Block\Navigation" name="affiliate_navigation" before="-">
                    <arguments>
                        <argument name="css_class" xsi:type="string">nav items</argument>
                    </arguments>
                    <block class="Magento\Framework\View\Element\Html\Link\Current" name="affiliate-navigation-home-link">
                        <arguments>
                            <argument name="label" xsi:type="string" translate="true">My Affiliate</argument>
                            <argument name="path" xsi:type="string">affiliate/</argument>
                            <argument name="sort_order" xsi:type="string">0</argument>
                            <argument name="active" xsi:type="string">both</argument>
                        </arguments>
                    </block>
                    <block class="Magento\Framework\View\Element\Html\Link\Current" name="affiliate-navigation-signup-link">
                        <arguments>
                            <argument name="label" xsi:type="string" translate="true">Signup</argument>
                            <argument name="path" xsi:type="string">affiliate/account/signup/</argument>
                            <argument name="sort_order" xsi:type="string">5</argument>
                            <argument name="active" xsi:type="string">guess</argument>
                        </arguments>
                    </block>
                    <block class="Magento\Framework\View\Element\Html\Link\Current" name="affiliate-navigation-compaigns-link">
                        <arguments>
                            <argument name="label" xsi:type="string" translate="true">Campaigns</argument>
                            <argument name="path" xsi:type="string">affiliate/account/campaigns</argument>
                            <argument name="sort_order" xsi:type="string">7</argument>
                            <argument name="active" xsi:type="string">login</argument>
                        </arguments>
                    </block>

                    <block class="Magento\Framework\View\Element\Html\Link\Current" name="affiliate-navigation-banner-link" ifconfig="affiliate/refer/enable">
                        <arguments>
                            <argument name="label" xsi:type="string" translate="true">Affiliate Links and Banners</argument>
                            <argument name="path" xsi:type="string">affiliate/account/banner</argument>
                            <argument name="sort_order" xsi:type="string">25</argument>
                            <argument name="active" xsi:type="string">login</argument>
                        </arguments>
                    </block>

                    <block class="Magento\Framework\View\Element\Html\Link\Current" name="affiliate-navigation-withdraw-link">
                        <arguments>
                            <argument name="label" xsi:type="string" translate="true">My Withdrawal</argument>
                            <argument name="path" xsi:type="string">affiliate/account/withdraw</argument>
                            <argument name="sort_order" xsi:type="string">30</argument>
                            <argument name="active" xsi:type="string">login</argument>
                        </arguments>
                    </block>
                    <block class="Magento\Framework\View\Element\Html\Link\Current" name="affiliate-navigation-commissionlogs-link">
                        <arguments>
                            <argument name="label" xsi:type="string" translate="true">Balance History</argument>
                            <argument name="path" xsi:type="string">affiliate/account/commissionlogs</argument>
                            <argument name="sort_order" xsi:type="string">31</argument>
                            <argument name="active" xsi:type="string">login</argument>
                        </arguments>
                    </block>

                    <block class="Magento\Framework\View\Element\Html\Link\Current" name="affiliate-navigation-subscribe-link">
                        <arguments>
                            <argument name="label" xsi:type="string" translate="true">Settings</argument>
                            <argument name="path" xsi:type="string">affiliate/account/subscribe</argument>
                            <argument name="sort_order" xsi:type="string">90</argument>
                            <argument name="active" xsi:type="string">login</argument>
                        </arguments>
                    </block>


                </block>
            </block>
        </referenceContainer>
        <move element="page.main.title" destination="content.top" before="-"/>
    </body>
</page>
