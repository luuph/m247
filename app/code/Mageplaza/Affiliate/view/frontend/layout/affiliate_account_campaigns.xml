<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="2columns-left" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="affiliate_account"/>
    <head>
        <css src="Mageplaza_Affiliate::css/campaigns_style.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="Mageplaza\Affiliate\Block\Account\Campaigns" name="affiliate.account.campaigns" template="Mageplaza_Affiliate::account/campaigns.phtml" cacheable="false">
                <block class="Mageplaza\Affiliate\Block\Account\Campaigns\Content" name="affiliate.account.campaigns.content" as="campaigns.content" template="Mageplaza_Affiliate::account/campaigns/content.phtml"/>
            </block>
        </referenceContainer>
        <referenceBlock name="breadcrumbs">
            <action method="addCrumb">
                <argument name="crumbName" xsi:type="string">Affiliate Campaigns</argument>
                <argument name="crumbInfo" xsi:type="array">
                    <item name="title" xsi:type="string" translate="true">Affiliate Campaigns</item>
                    <item name="label" xsi:type="string" translate="true">Affiliate Campaigns</item>
                </argument>
            </action>
        </referenceBlock>
    </body>

</page>
