<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="2columns-left" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="affiliate_account"/>
    <body>
        <referenceContainer name="content">
            <block class="Mageplaza\Affiliate\Block\Account\Commissionlogs" name="affiliate.account.commissionlogs" template="Mageplaza_Affiliate::account/commissionlogs.phtml" cacheable="false">
                <block class="Mageplaza\Affiliate\Block\Account\Commissionlogs\Withdraw" name="affiliate.account.commissionlogs.withdraw" as="commissionlogs.withdraw" template="Mageplaza_Affiliate::account/commissionlogs/withdraw.phtml"/>
                <block class="Mageplaza\Affiliate\Block\Account\Commissionlogs\Commissions" name="affiliate.account.commissionlogs.sales" as="commissionlogs.sales" template="Mageplaza_Affiliate::account/commissionlogs/commissions.phtml"/>
            </block>
        </referenceContainer>

        <referenceBlock name="breadcrumbs">
            <action method="addCrumb">
                <argument name="crumbName" xsi:type="string">Balance History</argument>
                <argument name="crumbInfo" xsi:type="array">
                    <item name="title" xsi:type="string" translate="true">Balance History</item>
                    <item name="label" xsi:type="string" translate="true">Balance History</item>
                </argument>
            </action>
        </referenceBlock>
    </body>

</page>
