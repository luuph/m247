<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="2columns-left" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="affiliate_account"/>
    <body>
        <referenceContainer name="content">
            <block class="Mageplaza\Affiliate\Block\Account\Withdraw\View" name="affiliate.account.withdraw.view" template="Mageplaza_Affiliate::account/withdraw/view.phtml" cacheable="false"/>
        </referenceContainer>
        <referenceBlock name="breadcrumbs">
            <action method="addCrumb">
                <argument name="crumbName" xsi:type="string">My Withdrawal</argument>
                <argument name="crumbInfo" xsi:type="array">
                    <item name="title" xsi:type="string" translate="true">My Withdrawal</item>
                    <item name="label" xsi:type="string" translate="true">My Withdrawal</item>
                    <item name="link" xsi:type="string">/affiliate/account/withdraw/</item>
                </argument>
            </action>
            <action method="addCrumb">
                <argument name="crumbName" xsi:type="string">View</argument>
                <argument name="crumbInfo" xsi:type="array">
                    <item name="title" xsi:type="string" translate="true">View</item>
                    <item name="label" xsi:type="string" translate="true">View</item>
                </argument>
            </action>
        </referenceBlock>
    </body>
</page>
