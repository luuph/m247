<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="2columns-left" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="affiliate_account"/>
    <body>
        <referenceContainer name="content">
            <block class="Mageplaza\Affiliate\Block\Dashboard" name="mp.affiliate.account.dashboard" template="Mageplaza_Affiliate::dashboard.phtml" cacheable="false" ifconfig="affiliate/general/enabled">
                <container name="dashboard.extra">
                </container>
            <block class="Mageplaza\Affiliate\Block\Account\Home" name="affiliate.account.home" template="Mageplaza_Affiliate::account/home.phtml" cacheable="false"/>
            <block class="Mageplaza\Affiliate\Block\Account\Campaigns\Content" name="affiliate.account.campaigns.referral" template="Mageplaza_Affiliate::account/campaigns/referral.phtml" cacheable="false"/>
            </block>
        </referenceContainer>
        <referenceBlock name="breadcrumbs">
            <action method="addCrumb">
                <argument name="crumbName" xsi:type="string">My Affiliate</argument>
                <argument name="crumbInfo" xsi:type="array">
                    <item name="title" xsi:type="string" translate="true">My Affiliate</item>
                    <item name="label" xsi:type="string" translate="true">My Affiliate</item>
                </argument>
            </action>
        </referenceBlock>
    </body>
</page>
