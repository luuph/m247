<script>
    require([
        "jquery",
        "mage/mage"
    ], function ($) {
        var dataForm        = $('#form-validate'),
            referCodeInput  = $('#refer_code');

        dataForm.mage('validation', {
            errorPlacement: function (error, element) {
                error.insertAfter(element);
            }
        });

        $(document).ready(function () {
            var createUrlButton = $('#create-refer-url-button'),
                createUrlInput  = $('#create-refer-url'),
                referRrl        = $('#link_referral .text_copy'),
                form            = $('.affiliate-refer-type #form-validate'),
                form_referral   = $('#referral_url'),
                param           = '<?= /* @noEscape */ $block->getSharingParam() ?>',
                editBtn         = $('#create-edit-code-button'),
                saveBtn         = $('#saveCouponPrefix');

            createUrlButton.click(function () {
                if (createUrlInput.val() && form_referral[0].checkValidity()) {
                    referRrl.text(createUrlInput.val() + param);
                    referRrl.attr('title', createUrlInput.val() + param);
                } else {
                    form_referral[0].reportValidity()
                }
            });

            editBtn.click(function () {
                referCodeInput.prop('disabled', false);
                referCodeInput.focus();
                editBtn.attr('class', 'btn_close_popup d-none');
                saveBtn.attr('class', 'btn_close_popup d-block');
            });

            form.submit(function () {
                $("<input />").attr("type", "hidden")
                .attr("name", "refer_url")
                .attr("value", referRrl.text())
                .appendTo(form);
                return true;
            });
        });

        $('#coupon-prefix-form').mage('validation');
        $('#saveCouponPrefix').on('click', function (event) {
            event.preventDefault(); // Prevent the default form submission
            if ($('#coupon-prefix-form').valid()) {
                var ajaxUrl = "<?= /* @noEscape */ $block->getUrl('affiliate/account/savecouponprefix') ?>";
                var text = $('#refer_code').val().trim();
                $.ajax({
                    showLoader: true,
                    url: ajaxUrl,
                    data: {form_key: window.FORM_KEY, campaign_coupon_prefix: text},
                    type: "POST"
                }).done(function (data) {
                    referCodeInput.val(text.toUpperCase());
                    $('.page.messages > div').show();
                    referCodeInput.prop('disabled', true);
                    $('#saveCouponPrefix').attr('class', 'btn_close_popup d-none');
                    $('#create-edit-code-button').attr('class', 'btn_close_popup d-block');
                    if ($('#maincontent').find('.messages')) {
                        setTimeout(function () {
                            $('.page.messages > div').hide();

                        }, 3000);
                    }
                });
            } else {
                console.log('Form is not valid.');
            }
        });

    });


</script>

