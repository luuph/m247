                $('.get_referral_link').click(function() {
                    var textToCopy = $(this).data('text');
                    copyToClipboard(textToCopy);
                    $(this).parent().find('.copied_text').attr('class', 'copied_text d-block');
                    setTimeout(() => {
                        $(this).parent().find('.copied_text').attr('class', 'copied_text d-none');
                    }, 1000)

                });
            });

            function copyToClipboard(text) {
                var $tempTextarea = $('<textarea>');
                $tempTextarea.val(text);
                $('body').append($tempTextarea);
                $tempTextarea.select();
                document.execCommand('copy');
                $tempTextarea.remove();
            }

        });

    </script>
