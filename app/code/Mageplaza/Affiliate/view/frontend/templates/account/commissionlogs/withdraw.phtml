<script>
    require(['jquery', 'mage/apply/main'], function ($,mage) {
        $(document).ready(function () {
            $('#reports_withdraw #limiter').on('change', function (event) {
                event.preventDefault();
                event.stopImmediatePropagation();
                let selectedValue = $(this).val();
                $.ajax({
                    showLoader: true,
                    url: selectedValue + '&type=withdraw',
                    type: "GET"
                }).done(function (data) {
                    $('#reports_withdraw').html(data.html);
                });
            });

            $('#reports_withdraw .items.pages-items .item a').on('click', function (event) {
                event.preventDefault();
                event.stopImmediatePropagation();
                let selectedValue = $(this).attr('href'); // Use attr('href') to get the href attribute
                $.ajax({
                    showLoader: true,
                    url: selectedValue + '&type=withdraw',
                    type: "GET"
                }).done(function (data) {
                    $('#reports_withdraw').html(data.html);
                });
            });
        });
    });
</script>
<div id="modal-view-withdraw">
    <div class="modal-body-content">
    </div>
</div>
<script type="text/javascript">
    require([
        "jquery",
        "Magento_Ui/js/modal/modal"
    ],function($, modal) {

        var options = {
            type: 'slide',
            responsive: true,
            title: '',
            buttons: [],
            modalClass: 'slide-withdraw-view',
        };

        var popup = modal(options, $('#modal-view-withdraw'));
        $(".view-withdraw").click(function() {
            var viewCampaign = $(this).siblings('.affiliate-view-withdraw').clone();
            $(".modal-body-content").html(viewCampaign.html());

            $('#modal-view-withdraw').modal('openModal');
        });
    });
</script>
<style>
    @media only screen and (min-width: 1024px) {
        .modal-slide.slide-withdraw-view { left: calc(100% - 1000px); }
    }

</style>
