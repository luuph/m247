<script type="text/javascript">
    require([
        "jquery",
    ], function ($) {
        var urlWithdraw = "<?= $tab_current === 'withdraw' ? $block->escapeUrl($block->getUrl('*/account/withdraw')) :  $block->escapeUrl($block->getUrl('*/account/commissionlogs')) ?>";
        var targetLink = $('ul.nav.items li.nav.item a[href="' + urlWithdraw + '"]');
        if (targetLink.length > 0) {
            targetLink.closest('li.nav.item').addClass('current');
        }
    });

</script>