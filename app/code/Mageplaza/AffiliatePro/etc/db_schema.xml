<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
  <table name="mageplaza_affiliate_banner" resource="default" engine="innodb" comment="Banner Table">
    <column xsi:type="int" name="banner_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Banner ID"/>
    <column xsi:type="varchar" name="title" nullable="true" length="255" comment="Banner Title"/>
    <column xsi:type="text" name="content" nullable="true" comment="Banner Content"/>
    <column xsi:type="varchar" name="link" nullable="true" length="255" comment="Banner Link"/>
    <column xsi:type="int" name="status" padding="11" unsigned="false" nullable="true" identity="false" comment="Banner Status"/>
    <column xsi:type="int" name="rel_nofollow" padding="11" unsigned="false" nullable="true" identity="false" comment="Banner Rel Nofollow"/>
    <column xsi:type="int" name="campaign_id" padding="11" unsigned="false" nullable="true" identity="false" comment="Banner Campaign ID"/>
    <column xsi:type="timestamp" name="created_at" on_update="false" nullable="true" comment="Banner Created At"/>
    <column xsi:type="timestamp" name="updated_at" on_update="false" nullable="true" comment="Banner Updated At"/>
    <constraint xsi:type="primary" referenceId="PRIMARY">
      <column name="banner_id"/>
    </constraint>
  </table>
</schema>
