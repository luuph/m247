<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <!--=========================================== BANNER AFFILIATE =================================================-->
    <route url="/V1/mpAffiliate/banners/:id" method="GET">
        <service class="Mageplaza\AffiliatePro\Api\BannerRepositoryInterface" method="get"/>
        <resources>
            <resource ref="Mageplaza_Affiliate::affiliate"/>
        </resources>
    </route>
    <route url="/V1/mpAffiliate/banners" method="GET">
        <service class="Mageplaza\AffiliatePro\Api\BannerRepositoryInterface" method="getList"/>
        <resources>
            <resource ref="Mageplaza_Affiliate::affiliate"/>
        </resources>
    </route>
    <route url="/V1/mpAffiliate/banners/:id" method="DELETE">
        <service class="Mageplaza\AffiliatePro\Api\BannerRepositoryInterface" method="delete"/>
        <resources>
            <resource ref="Mageplaza_Affiliate::affiliate"/>
        </resources>
    </route>
    <route url="/V1/mpAffiliate/mine/banners" method="GET">
        <service class="Mageplaza\AffiliatePro\Api\BannerRepositoryInterface" method="getAffiliateBanner"/>
        <resources>
            <resource ref="self" />
        </resources>
    </route>
</routes>
