<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="2columns-left" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="affiliate_account"/>
    <head>
        <css src="Mageplaza_Core::css/owl.carousel.css"/>
        <css src="Mageplaza_Core::css/owl.theme.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <referenceBlock name="affiliate.account.banner">
                <block class="Mageplaza\AffiliatePro\Block\Account\Banner" name="affiliate.account.banner.banner" template="Mageplaza_AffiliatePro::account/banner/content_banner.phtml" />
            </referenceBlock>
            <referenceBlock name="affiliate.account.banner">
                <action method="setTemplate" >
                    <argument name="template" xsi:type="string">Mageplaza_AffiliatePro::account/banner.phtml</argument>
                </action>
            </referenceBlock>

        </referenceContainer>

    </body>
</page>
