<script type="text/javascript">


    require(['jquery', 'mage/apply/main'], function ($, mage) {
        $('#banner-affiliate-campaigns-list').on('change', function () {
            var ajaxUrl = "<?= /* @noEscape */ $block->getUrl('affiliate/account/getContentBanner') ?>";
            $.ajax({
                showLoader: true,
                url: ajaxUrl + '?campaign_id=' + this.value,
                type: "GET"
            }).done(function (data) {
                $('#content_banner').html(data.html);
                if (mage) {
                    mage.apply();
                }
            });
        });
    });
</script>
