<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Reports::report">
                    <resource id="Mageplaza_Affiliate::reports" title="Mageplaza Affiliate Reports" translate="title" sortOrder="90">
                        <resource id="Mageplaza_Affiliate::bestsellers" title="Bestsellers" translate="title" sortOrder="10"/>
                        <resource id="Mageplaza_Affiliate::reports_accounts" title="Accounts" translate="title" sortOrder="20"/>
                        <resource id="Mageplaza_Affiliate::reports_sales" title="Sales" translate="title" sortOrder="30"/>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>