<?php
/** @var \Mageplaza\AffiliateUltimate\Block\Adminhtml\Reports\Dashboard\TopAccount $block */
?>

<div class="dashboard-item-content">
    <?php if ($block->getNewAccount()->getSize()): ?>
        <table class="admin__table-primary dashboard-data" id="lastOrdersGrid_table">
            <thead>
            <tr>
                <th class="data-grid-th  no-link col-customer"><span><?= /* @noEscape */ __('Name') ?></span></th>
                <th class="data-grid-th  no-link col-items"><span><?= /* @noEscape */ __('Email') ?></span></th>
                <th class="data-grid-th  no-link col-total"><span><?= /* @noEscape */ __('Sales Amount') ?></span></th>
                <th class="data-grid-th  no-link col-total"><span><?= /* @noEscape */ __('Number of Orders') ?></span></th>
                <th class="data-grid-th  no-link col-total"><span><?= /* @noEscape */ __('Balance') ?></span></th>
                <th class="data-grid-th  no-link col-total"><span><?= /* @noEscape */ __('Commission') ?></span></th>
                <th class="data-grid-th  no-link col-total"><span><?= /* @noEscape */ __('Status') ?></span></th>
            </tr>
            </thead>
            <tbody>
            <?php foreach ($block->getNewAccount() as $account): ?>
                <tr>
                    <td class=" col-customer "><?= /* @noEscape */ $account->getName() ?></td>
                    <td class=" col-customer "><?= /* @noEscape */ $account->getEmail() ?></td>
                    <td class=" col-customer "><?= /* @noEscape */ $block->formatPrice($account->getTotalAmount()) ?></td>
                    <td class=" col-customer "><?= /* @noEscape */ $account->getTotalOrder() ?></td>
                    <td class=" col-items col-number "><?= /* @noEscape */ $block->formatPrice($account->getBalance()) ?></td>
                    <td class=" col-items col-number "><?= /* @noEscape */ $block->formatPrice($account->getTotalCommission()) ?></td>
                    <td class=" col-items col-number "><?= /* @noEscape */ $block->getStatus($account->getStatus()) ?></td>
                </tr>
            <?php endforeach; ?>
            </tbody>
        </table>
    <?php else: ?>
        <div class="empty-text"><?= /* @noEscape */ __('We couldn\'t find any records.') ?></div>
    <?php endif; ?>
</div>
