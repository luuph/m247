<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="mageplaza_brand" resource="default" engine="innodb" comment="Mageplaza Brand Table">
        <column xsi:type="int" name="brand_id" padding="10" unsigned="true" nullable="false" identity="true"
                comment="Brand ID"/>
        <column xsi:type="int" name="option_id" padding="10" unsigned="true" nullable="false"
                comment="Attribute Option Id"/>
        <column xsi:type="int" name="store_id" nullable="false" default="0" comment="Config Scope Id"/>
        <column xsi:type="text" name="page_title" nullable="true" comment="Brand Page Title"/>
        <column xsi:type="text" name="url_key" nullable="false" comment="Url Key"/>
        <column xsi:type="text" name="image" nullable="true" comment="Brand Image"/>
        <column xsi:type="smallint" name="is_featured" padding="6" unsigned="false" nullable="false" identity="false"
                default="0" comment="Featured Brand"/>
        <column xsi:type="mediumtext" name="short_description" nullable="true" comment="Brand Short Description"/>
        <column xsi:type="mediumtext" name="description" nullable="true" comment="Brand Description"/>
        <column xsi:type="text" name="static_block" nullable="true" comment="Static Block"/>
        <column xsi:type="text" name="meta_title" nullable="true" comment="Meta Title"/>
        <column xsi:type="text" name="meta_keywords" nullable="true" comment="Meta Keywords"/>
        <column xsi:type="text" name="meta_description" nullable="true" comment="Meta Description"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="brand_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="Mageplaza_Shopbybrand_Eav_Attribute_Option" table="mageplaza_brand"
                    column="option_id" referenceTable="eav_attribute_option" referenceColumn="option_id"
                    onDelete="CASCADE"/>
        <index referenceId="mageplaza_brand_index_option_id_store_id" indexType="btree">
            <column name="option_id"/>
            <column name="store_id"/>
        </index>
        <column xsi:type="int" name="is_display" padding="11" unsigned="false" nullable="true" identity="false"
                default="1" comment="Display Brand"/>
        <column xsi:type="text" name="related_brands" nullable="true" comment="Related Brands"/>
    </table>
    <table name="mageplaza_shopbybrand_category" resource="default" engine="innodb"
           comment="Mageplaza Category Brand Table">
        <column xsi:type="int" name="cat_id" padding="10" unsigned="true" nullable="false" identity="true"
                comment="Brand Category ID"/>
        <column xsi:type="smallint" name="status" padding="6" unsigned="false" nullable="false" identity="false"
                default="1" comment="Status"/>
        <column xsi:type="varchar" name="store_ids" nullable="false" length="255" default="0" comment="Store Ids"/>
        <column xsi:type="text" name="name" nullable="true" comment="Brand Category Name"/>
        <column xsi:type="varchar" name="url_key" nullable="false" length="255" comment="Url Key"/>
        <column xsi:type="text" name="meta_title" nullable="true" comment="Meta Title"/>
        <column xsi:type="text" name="meta_keywords" nullable="true" comment="Meta Keywords"/>
        <column xsi:type="mediumtext" name="meta_description" nullable="true" comment="Meta Description"/>
        <column xsi:type="text" name="meta_robots" nullable="true" comment="Meta Robots"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Brand Category Creation Time"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Brand Category Modification Time"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="cat_id"/>
        </constraint>
        <index referenceId="mageplaza_shopbybrand_category_url_key" indexType="fulltext">
            <column name="url_key"/>
        </index>
    </table>
    <table name="mageplaza_shopbybrand_brand_category" resource="default" engine="innodb"
           comment="Mageplaza Brand Category Table">
        <column xsi:type="int" name="cat_id" padding="10" unsigned="true" nullable="false" identity="true"
                comment="Brand Category ID"/>
        <column xsi:type="int" name="option_id" padding="10" unsigned="true" nullable="false"
                comment="Attribute Option Id"/>
        <column xsi:type="int" name="position" padding="10" nullable="false" default="0" comment="Brand Position"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="cat_id"/>
            <column name="option_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="Mageplaza_Shopbybrand_Brand_Category_Eav_Attribute_Option"
                    table="mageplaza_shopbybrand_brand_category" column="option_id"
                    referenceTable="eav_attribute_option" referenceColumn="option_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="Mageplaza_Shopbybrand_Brand_Category_Brand"
                    table="mageplaza_shopbybrand_brand_category" column="cat_id"
                    referenceTable="mageplaza_shopbybrand_category" referenceColumn="cat_id" onDelete="CASCADE"/>
        <constraint xsi:type="unique" referenceId="Mageplaza_Shopbybrand_Brand_Category_Cat_Option">
            <column name="cat_id"/>
            <column name="option_id"/>
        </constraint>
        <index referenceId="mageplaza_shopbybrand_brand_category_option_id_cat_id_index" indexType="btree">
            <column name="option_id"/>
            <column name="cat_id"/>
        </index>
    </table>
    <table name="mageplaza_brand_reports_reindex" resource="default" engine="innodb"
           comment="Mageplaza Brand Reports Reindex Table">
        <column xsi:type="int" name="id" padding="10" unsigned="true" nullable="false" identity="true" comment="Id"/>
        <column xsi:type="varchar" name="code" nullable="true" length="255" comment="Reports Code"/>
        <column xsi:type="varchar" name="name" nullable="true" length="255" comment="Reports Name"/>
        <column xsi:type="varchar" name="description" nullable="true" length="255" comment="Reports Description"/>
        <column xsi:type="timestamp" name="updated_at" on_update="false" nullable="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
    </table>
    <table name="mageplaza_brand_report" resource="default" engine="innodb" comment="Mageplaza Reports Sales By Brand">
        <column xsi:type="int" name="id" padding="10" unsigned="true" nullable="false" identity="true" comment="Id"/>
        <column xsi:type="date" name="order_created_at" comment="Period"/>
        <column xsi:type="int" name="store_id" padding="11" unsigned="false" nullable="true" identity="false"
                comment="Store Id"/>
        <column xsi:type="varchar" name="status" nullable="true" length="10" comment="Order Status"/>
        <column xsi:type="int" name="order_id" padding="11" unsigned="false" nullable="true" identity="false"
                comment="Order Id"/>
        <column xsi:type="int" name="qty_order" padding="11" unsigned="false" nullable="true" identity="false"
                comment="Total Qty Order"/>
        <column xsi:type="int" name="qty_item" padding="11" unsigned="false" nullable="true" identity="false"
                comment="Qty Item"/>
        <column xsi:type="decimal" name="row_total" scale="04" precision="20" unsigned="false" nullable="true"
                comment="Row Total"/>
        <column xsi:type="decimal" name="discount" scale="04" precision="20" unsigned="false" nullable="true"
                comment="Discount"/>
        <column xsi:type="decimal" name="tax" scale="04" precision="20" unsigned="false" nullable="true" comment="Tax"/>
        <column xsi:type="decimal" name="refunded" scale="04" precision="20" unsigned="false" nullable="true"
                comment="Refunded"/>
        <column xsi:type="decimal" name="canceled" scale="04" precision="20" unsigned="false" nullable="true"
                comment="Canceled"/>
        <column xsi:type="int" name="product_id" padding="11" unsigned="false" nullable="true" identity="false"
                comment="Product Id"/>
        <column xsi:type="int" name="item_id" padding="11" unsigned="false" nullable="true" identity="false"
                comment="Product Id"/>
        <column xsi:type="varchar" name="product_name" nullable="true" length="255" comment="Product Name"/>
        <column xsi:type="varchar" name="sku" nullable="true" length="255" comment="SKU"/>
        <column xsi:type="int" name="attribute_id" padding="11" unsigned="false" nullable="true" identity="false"
                comment="Attribute Id"/>
        <column xsi:type="varchar" name="attribute_code" nullable="true" length="255" comment="Attribute Code"/>
        <column xsi:type="varchar" name="attribute_value" nullable="true" length="255" comment="Attribute Value"/>
        <column xsi:type="varchar" name="attribute_name" nullable="true" length="255" comment="Attribute Name"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
    </table>

    <table name="mageplaza_brand_qty" resource="default" engine="innodb" comment="Mageplaza Brand Qty index">
        <column xsi:type="smallint" name="qty" nullable="true"/>
        <column xsi:type="smallint" name="store_id" nullable="false"/>
        <column xsi:type="varchar" name="attr_code" nullable="false"/>
        <column xsi:type="varchar" name="attr_code_option_id_store_id" nullable="false" comment="Unique of Index"/>
        <constraint xsi:type="unique" referenceId="MAGEPLAZA_BRAND_QTY_ATTR_CODE_OPTION_STORE">
            <column name="attr_code_option_id_store_id"/>
        </constraint>
    </table>
</schema>
