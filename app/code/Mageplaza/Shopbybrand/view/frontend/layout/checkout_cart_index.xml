<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <referenceContainer name="content">
        <block class="Mageplaza\Shopbybrand\Block\Product\ProductList\Crosssell" name="checkout.cart.crosssell" template="Mageplaza_Shopbybrand::product/list/items.phtml" after="-" ifconfig="checkout/cart/crosssell_enabled">
            <arguments>
                <argument name="type" xsi:type="string">crosssell</argument>
                <argument name="view_model" xsi:type="object">Magento\Catalog\ViewModel\Product\Listing\PreparePostData</argument>
            </arguments>
            <block class="Magento\Catalog\Block\Product\ProductList\Item\Container" name="crosssell.product.addto" as="addto">
                <block class="Magento\Catalog\Block\Product\ProductList\Item\AddTo\Compare"
                       name="crosssell.product.addto.compare" as="compare"
                       template="Magento_Catalog::product/list/addto/compare.phtml"/>
            </block>
        </block>
    </referenceContainer>
    <referenceContainer name="additional.product.info">
        <block class="Mageplaza\Shopbybrand\Block\Cart\BrandInfo" name="mp_shopbybrand_cart_brand_info" template="Mageplaza_Shopbybrand::cart/item/brandInfo.phtml" />
    </referenceContainer>
</page>