<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">

    <body>
        <referenceBlock name="brand.product.logo">
            <action method="setTemplate" ifconfig="shopbybrand/general/enabled">
                <argument name="template" xsi:type="string">Mageplaza_Shopbybrand::hyva/product/logo.phtml</argument>
            </action>
        </referenceBlock>


        <referenceBlock name="related.brand.product.tab.detail">
            <action method="setTemplate" ifconfig="shopbybrand/general/enabled">
                <argument name="template" xsi:type="string">Mageplaza_Shopbybrand::hyva/product/tabproduct/list.phtml</argument>
            </action>
        </referenceBlock>

        <referenceBlock name="upsell">
            <action method="setTemplate" ifconfig="shopbybrand/general/enabled">
                <argument name="template" xsi:type="string">Mageplaza_Shopbybrand::hyva/product/slider/product-slider.phtml</argument>
            </action>
        </referenceBlock>

        <referenceBlock name="related">
            <action method="setTemplate" ifconfig="shopbybrand/general/enabled">
                <argument name="template" xsi:type="string">Mageplaza_Shopbybrand::hyva/product/slider/product-slider.phtml</argument>
            </action>
        </referenceBlock>

        <referenceBlock name="product.info.upsell" remove="true"/>
        <referenceBlock name="catalog.product.related" remove="true"/>


    </body>
</page>
