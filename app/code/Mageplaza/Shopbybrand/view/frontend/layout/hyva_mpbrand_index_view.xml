<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="2columns-left" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="brand.category.products.list">
            <action method="setTemplate" ifconfig="shopbybrand/general/enabled">
                <argument name="template" xsi:type="string">Mageplaza_Shopbybrand::hyva/brand/productList.phtml</argument>
            </action>
        </referenceBlock>

        <referenceBlock name="related_brands">
            <action method="setTemplate" ifconfig="shopbybrand/general/enabled">
                <argument name="template" xsi:type="string">Mageplaza_Shopbybrand::hyva/brand/related_brands.phtml</argument>
            </action>
        </referenceBlock>


        <referenceBlock name="brand.info">
            <action method="setTemplate" ifconfig="shopbybrand/general/enabled">
                <argument name="template" xsi:type="string">Mageplaza_Shopbybrand::hyva/brand_info.phtml</argument>
            </action>
        </referenceBlock>

        <move element="category.products.list" destination="brand.category.products.list"/>

        <referenceBlock name="product_list_toolbar">
            <action method="setTemplate" ifconfig="shopbybrand/general/enabled">
                <argument name="template" xsi:type="string">Mageplaza_Shopbybrand::hyva/product/list/toolbar.phtml</argument>
            </action>
        </referenceBlock>

        <referenceBlock name="product_list_item">
            <action method="setTemplate" ifconfig="shopbybrand/general/enabled">
                <argument name="template" xsi:type="string">Mageplaza_Shopbybrand::hyva/brand/list/item.phtml</argument>
            </action>
            <block name="loading" template="Hyva_Theme::ui/loading.phtml"/>
        </referenceBlock>
    </body>
</page>
