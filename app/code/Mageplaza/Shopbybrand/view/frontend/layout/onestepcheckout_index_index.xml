<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="checkout.root">
            <arguments>
                <argument name="jsLayout" xsi:type="array">
                    <item name="components" xsi:type="array">
                        <item name="checkout" xsi:type="array">
                            <item name="children" xsi:type="array">
                                <item name="sidebar" xsi:type="array">
                                    <item name="children" xsi:type="array">
                                        <item name="summary" xsi:type="array">
                                            <item name="children" xsi:type="array">
                                                <item name="cart_items" xsi:type="array">
                                                    <item name="children" xsi:type="array">
                                                        <item name="details" xsi:type="array">
                                                            <item name="children" xsi:type="array">
                                                                <item name="brand" xsi:type="array">
                                                                    <item name="component" xsi:type="string">Mageplaza_Shopbybrand/js/summary/item/osc/brand</item>
                                                                    <item name="sortOrder" xsi:type="string">100</item>
                                                                    <item name="config" xsi:type="array">
                                                                        <item name="displayArea" xsi:type="string">after_item_details</item>
                                                                        <item name="componentDisabled" xsi:type="helper" helper="Mageplaza\Shopbybrand\Helper\Data::isOscDisable"/>
                                                                    </item>
                                                                </item>
                                                            </item>
                                                        </item>
                                                    </item>
                                                </item>
                                            </item>
                                        </item>
                                    </item>
                                </item>
                            </item>
                        </item>
                    </item>
                </argument>
            </arguments>

        </referenceBlock>
    </body>
</page>