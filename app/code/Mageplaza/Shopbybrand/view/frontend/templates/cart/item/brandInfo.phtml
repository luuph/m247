use Mageplaza\Shopbybrand\Block\Cart\BrandInfo;
use Mageplaza\Shopbybrand\Model\Config\Source\ShowBrandInfo;
use Magento\Swatches\Model\Swatch;

/** @var BrandInfo $block */

$item       = $block->getItem();
$brand      = $block->getBrand($item);
$logoWidth  = $block->getLogoWidth();
$logoHeight = $block->getLogoHeight();
?>
<?php if (isset($brand) && $brand !== '' && $brand) : ?>
    <?php $brand->setShortDescription($block->getBrandDescription($brand)); ?>
    <?php if ((in_array(ShowBrandInfo::BRAND_LOGO, $block->showBrandInfoCheckout(), true))) : ?>
        <div class="product-brand-logo">
            <a href="<?= /** @noEscape */
            $block->getBrandUrl($brand) ?>">
                <?php if ($brand->getSwatchType() == Swatch::SWATCH_TYPE_VISUAL_COLOR): ?>
                    <img style="
                            background-color: <?= /** @noEscape */ $brand->getSwatchValue() ?>;
                            width: <?= /** @noEscape */
                    $logoWidth . 'px' ?>;
                            height: <?= /** @noEscape */
                    $logoHeight . 'px' ?>;">
                <?php else: ?>
                    <img src="<?= /** @noEscape */
                    $block->getBrandImageUrl($brand) ?>"
                         title="<?= /** @noEscape */
                         $brand->getValue() ?>"
                         alt="<?= /** @noEscape */
                         $brand->getValue() ?>"
                         style="width: <?= /** @noEscape */
                         $logoWidth . 'px' ?>;
                                 height: <?= /** @noEscape */
                         $logoHeight . 'px' ?>;">
                <?php endif; ?>
            </a>
        </div>
    <?php endif; ?>
    <?php if ((in_array(ShowBrandInfo::BRAND_NAME, $block->showBrandInfoCheckout(), true))) : ?>
        <div class="product-brand-name">
            <a href="<?= /** @noEscape */
            $block->getBrandUrl($brand) ?>">
                            <span title="<?= $block->escapeHtml($brand->getValue()) ?>"><?= $block->escapeHtml($brand->getValue()) ?>
                            </span>
            </a>
        </div>
    <?php endif; ?>
    <?php if ((in_array(ShowBrandInfo::BRAND_DESC, $block->showBrandInfoCheckout(), true))) : ?>
        <div class="product-brand-desc">
            <?= /** @noEscape */
            $block->shortenDesc($brand->getShortDescription()) ?>
            <?php if (strlen($brand->getShortDescription()) > 50) : ?>
                <p>
                    <a href="<?= $block->escapeUrl($block->getProductUrl($item)) ?>">
                        <i><?= $block->escapeHtml(__('Read more')) ?></i>
                    </a>
                </p>
            <?php endif; ?>
        </div>
    <?php endif; ?>
<?php endif; ?>
