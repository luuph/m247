use Magento\Swatches\Model\Swatch;

$timeId = time();
/** @var \Mageplaza\Shopbybrand\Block\Brand\Featured $block */
$featureBrands = $block->getFeaturedBrand();
$style = $block->getStyleDisplayFeature();
?>
<?php if (!empty($featureBrands)) : ?>
    <?= /** @noEscape */ $block->includeCssLib() ?>
    <div class="block-brand-feature widget">
        <div class="block-title" style="text-align: center;    font-size: 40px;font-weight: bold;">
            <h1 id="block-feature-brand-heading" role="heading"
                    aria-level="2"><?= /** @noEscape */ $block->getFeatureTitle() ?></h1>
        </div>
        <div class="block-content">
            <?php if (!empty($featureBrands) &&
            $style === \Mageplaza\Shopbybrand\Model\Config\Source\FeatureStyle::DISPLAY_SLIDER) : ?>
            <section class="brand-carousel splide"
                 id="feature-brand-carousel-<?= /** @noEscape */ $timeId ?>"
                 data-mage-init='{"brandSlider": {}}' style="width: calc(70%)">
                <div class="splide__track">
                    <ul class="splide__list">

            <?php endif; ?>
                <?php foreach ($featureBrands as $brand) : ?>
                    <?php if ($style === \Mageplaza\Shopbybrand\Model\Config\Source\FeatureStyle::DISPLAY_SLIDER) : ?>
                    <li class="relate-content item splide__slide">
                    <?php else : ?>
                    <li class="relate-content item mp-2 mp-sm-4 mp-xs-6 col-mp" style="float: left; padding: 10px 0;list-style: none">
                    <?php endif; ?>
                        <a href="<?= /** @noEscape */ $block->helper()->getBrandUrl($brand) ?>" class="hover:underline" style="display: flex; flex-direction: column; align-items: center">
                            <?php if ($brand->getSwatchType() == Swatch::SWATCH_TYPE_VISUAL_COLOR): ?>
                                <img class="img-responsive brand-image"
                                     style="background-color: <?= /** @noEscape */ $brand->getSwatchValue() ?>"
                                     width="<?= /** @noEscape */ $block->getLogoWidth() ?>"
                                     height="<?= /** @noEscape */ $block->getLogoHeight() ?>">
                            <?php else: ?>
                                <img class="img-responsive brand-image"
                                     src="<?= /** @noEscape */ $block->helper()->getBrandImageUrl($brand) ?>"
                                     width="<?= /** @noEscape */ $block->getLogoWidth() ?>"
                                     height="<?= /** @noEscape */ $block->getLogoHeight() ?>"
                                     alt="<?= /** @noEscape */ $brand->getValue() ?>">
                            <?php endif; ?>
                            <?php if ($block->showLabel()) : ?>
                                <span class="font-semibold"><?= /** @noEscape */ $brand->getValue() ?></span>
                            <?php endif; ?>
                        </a>
                    </li>

                <?php endforeach; ?>
            </div>
                </section>
                </div>

        </div>

<?php endif; ?>
<div style="clear: both"></div>

<style>
    .block-brand-feature .block-content {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        padding-left: 25px;
    }
</style>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        if(document.getElementById('feature-brand-carousel-<?= /** @noEscape */ $timeId ?>')) {
            new Splide('#feature-brand-carousel-<?= /** @noEscape */ $timeId ?>',{
                autoStart: true,
                start: 1,
                perPage: 5,
                perMove: 1,
                gap: 10,
                type: "loop",
                drag: "free",
                snap: false,
                pagination: true,
                interval: 4000,
                rewind: true,
                rewindByDrag: true,
                lazyLoad: true,
                autoplay: 'play',
                autoScroll: {
                    speed: 2
                },
                breakpoints: {
                    768: {
                        perPage: 1,
                        snap: true
                    },
                    1028: {
                        perPage: 2,
                        snap: true
                    }
                }
            }).mount();
        }
    });
</script>
<style>
    #feature-brand-carousel-<?= /** @noEscape */ $timeId ?> .splide__arrow--prev {
        left: -2.5em;
    }

    #feature-brand-carousel-<?= /** @noEscape */ $timeId ?> .splide__arrow--next {
        right: -2.5em;
    }
    #feature-brand-carousel-<?= /** @noEscape */ $timeId ?> .splide__arrow {
        background-color: <?= /** @noEscape */ $block->helper()->getBrandConfig('color') ?>;
    }
    #feature-brand-carousel-<?= /** @noEscape */ $timeId ?> .splide__arrow svg {
        fill: #ffffff;
    }
    #feature-brand-carousel-<?= /** @noEscape */ $timeId ?>  .splide__pagination__page {
        background-color: #cccccc;
    }
    #feature-brand-carousel-<?= /** @noEscape */ $timeId ?>  .splide__pagination {
        bottom: -2.5em;
    }
    #feature-brand-carousel-<?= /** @noEscape */ $timeId ?>  .splide__pagination__page.is-active {
        transform: unset;
        background-color: <?= /** @noEscape */ $block->helper()->getBrandConfig('color') ?>;
    }
</style>
