use Mageplaza\Shopbybrand\Block\Sidebar\BrandCategory;

/** @var BrandCategory $block */
$categories = $block->getCategories();
?>
<div class="block block-category-brand widget" id="block-category-brand-container">
    <div class="block-title">

        <h2 class="border-t border-container mb-6 pt-5 text-primary font-semibold text-lg" id="compare-sidebar">
            <?= /** @noEscape */ $block->getTitle() ?>        </h2>
    </div>
    <div class="block-content">
        <?php if ($categories->getSize()) : ?>
            <div class="filter-options-content" id='category-brand-menu'>
                <ul>
                    <?php foreach ($categories as $category) : ?>
                        <?php if ($block->getBrandQty($category->getId())) : ?>
                            <li>
                                <a href="<?= $block->escapeUrl($block->getCatUrl($category)) ?>">
                                    <span><?= /** @noEscape */
                                        $block->showBrandQty()
                                            ? $block->escapeHtml($category->getName()
                                            . ' (' . $block->getBrandQty($category->getId()) . ')')
                                            : $block->escapeHtml($category->getName()) ?></span>
                                </a>
                            </li>
                        <?php endif; ?>
                    <?php endforeach; ?>
                </ul>
            </div>
        <?php else : ?>
            <div class="filter-options-content pb-3" id='category-brand-menu'>
                <span><?= $block->escapeHtml(__('No categories available.')) ?></span>
            </div>
        <?php endif; ?>
    </div>
</div>
