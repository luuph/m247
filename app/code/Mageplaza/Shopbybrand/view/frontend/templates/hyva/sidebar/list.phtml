/** @var \Mageplaza\Shopbybrand\Block\Sidebar\BrandList $block */

use Magento\Swatches\Model\Swatch;

$brands = $block->getCollection();
if (!empty($brands)) :?>
<div class="block block-brand-thumbnail widget" id="block-brand-thumbnail-container">
    <div class="block-title">
        <h2 class="border-t border-container mb-6 pt-5 text-primary font-semibold text-lg" id="compare-sidebar">
            <?= /** @noEscape */ $block->getTitle() ?>        </h2>

    </div>
    <div class="block-content">
        <div class="filter-options-content" id='brand-thumbnail-menu'>
            <ul>
                <?php foreach ($brands as $brand) : ?>
                        <li style="padding:5px 0">
                            <a href='<?= /** @noEscape */ $block->getBrandUrl($brand) ?>'>
                                <div class="brand-items"
                                     id="item-<?= /** @noEscape */ $brand->getId() ?>" >
                                    <?php if ($brand->getSwatchType() == Swatch::SWATCH_TYPE_VISUAL_COLOR): ?>
                                        <img class="img-responsive brand-thumbnail-image" style="background-color: <?= /** @noEscape */ $brand->getSwatchValue() ?>; width: 40px;height: 40px; float: left;">
                                    <?php else: ?>
                                        <img class="img-responsive brand-thumbnail-image"
                                             src="<?= $brand->getImage() ? $block->escapeUrl($block->getBrandThumbnail($brand))
                                                 : $block->escapeUrl($block->helper()->getBrandImageUrl($brand)) ?>"
                                             style="width: 40px;height: 40px; float: left;border: 1px solid #d9d9d9; border-radius: 100%;" alt=""/>
                                    <?php endif; ?>
                                    <span style="font-size: 16px;
    font-weight: 600;
    padding-left: 15px;"><?= /** @noEscape */ $brand->getValue() ?></span>
                                </div>
                            </a>
                        </li>
                <?php endforeach; ?>
            </ul>
        </div>
        <div class="pages" id="brand-thumbnail-bottom" style="margin-top:10px">
            <a class="action btn btn-secondary px-4 text-sm" href="<?= /** @noEscape */ $block->getBrandUrl() ?>" style="width:fit-content;">
                <span><?= /** @noEscape */ __('View All') ?></span>
            </a>
        </div>
    </div>
</div>
<style>
li a .brand-items:hover {
    background-color: #d1d1d1;
}
li a .brand-items {
    height: 60px; display: flex; align-items: center
}
</style>
<?php endif; ?>
