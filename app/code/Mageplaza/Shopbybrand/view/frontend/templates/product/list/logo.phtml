use Magento\Swatches\Model\Swatch;
use Mageplaza\Shopbybrand\Block\Product\Logo;
use Mageplaza\Shopbybrand\Model\Config\Source\ShowBrandInfo;

/** @var Logo $block */

$helper = $block->helper();

if ($helper->isEnabled() && !in_array(ShowBrandInfo::NOT_SHOW, $block->showBrandInfo(), true)) {
    $brand = $helper->getBrandObject();
}

if ($block->getIsShowList() === 1) {
    $brand = $block->helper()->getBrand();
}
if ($brand == null) $brand = $block->getBrand();
?>
<?php if (isset($brand) && $brand !== '' && $brand->getIsDisplay()) : ?>
    <?php $brand->setShortDescription($helper->getBrandDescription($brand, true)); ?>
    <?php if (in_array(ShowBrandInfo::BRAND_LOGO, $block->showBrandInfoInListing(), true)) : ?>
        <div class="product-brand-logo">
            <a href="<?= /** @noEscape */ $helper->getBrandUrl($brand) ?>">
                <?php if ($brand->getSwatchType() == Swatch::SWATCH_TYPE_VISUAL_COLOR): ?>
                    <img class="img-responsive brand-thumbnail-image" style="background-color: <?= $brand->getSwatchValue() ?>; width: 30px;height: 30px;">
                <?php else: ?>
                    <img src="<?= /** @noEscape */ $brand->getImage() ?>"
                         title="<?= /** @noEscape */ $brand->getValue() ?>"
                         alt="<?= /** @noEscape */ $brand->getValue() ?>"
                         style="width: <?= /** @noEscape */
                         $block->getLogoWidth() . 'px' ?>;
                             height: <?= /** @noEscape */
                         $block->getLogoHeight() . 'px' ?>;">
                <?php endif; ?>

            </a>
        </div>
    <?php endif; ?>
    <?php if (in_array(ShowBrandInfo::BRAND_NAME, $block->showBrandInfoInListing(), true)) : ?>
        <div class="product-brand-name">
            <a href="<?= /** @noEscape */ $helper->getBrandUrl($brand) ?>">
                <span
                    title="<?= $block->escapeHtml($brand->getValue()) ?>"><?= $block->escapeHtml($brand->getValue()) ?>
                </span>
            </a>
        </div>
    <?php endif; ?>
    <?php if (in_array(ShowBrandInfo::BRAND_DESC, $block->showBrandInfoInListing(), true)) : ?>
        <div class="product-brand-desc">
            <?= /** @noEscape */ $brand->getShortDescription() ?>
        </div>
    <?php endif; ?>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.product.details.product-item-details').forEach(function(productDetails) {
                const brandName = productDetails.querySelector('.product-brand-name');
                const productName = productDetails.querySelector('.product.name.product-item-name');

                if (brandName && productName) {
                    // Di chuyển brandName lên trước productName
                    productDetails.insertBefore(brandName, productName);
                }
            });
        });
    </script>
<?php endif; ?>
