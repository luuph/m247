/** @var \Mageplaza\Shopbybrand\Block\Sidebar\Featured $block */

use Magento\Swatches\Model\Swatch;

$featureBrands = $block->getFeaturedBrand();
$timeId = time();

if (!empty($featureBrands)) : ?>
    <?= /** @noEscape */ $block->includeCssLib() ?>
    <div class="block block-brand-feature widget">
        <?php if ($block->showTitle()) : ?>
            <div class="block-title" style="display: flex;justify-content: center;">
                <strong id="block-feature-brand-heading" role="heading"
                        aria-level="2"><?= /** @noEscape */ $block->getFeatureTitle() ?></strong>
            </div>
        <?php endif; ?>
        <div class="block-content">
            <div class="owl-carousel owl-theme brand-carousel"
                 id="feature-brand-carousel-<?= /** @noEscape */ $timeId ?>"
                 data-mage-init='{"brandSlider": {"items":"1"}}'>
                <?php foreach ($featureBrands as $brand) : ?>
                    <div class="relate-content item">
                        <a href="<?= /** @noEscape */ $block->helper()->getBrandUrl($brand) ?>">
                            <?php if ($brand->getSwatchType() == Swatch::SWATCH_TYPE_VISUAL_COLOR): ?>
                                <img class="img-responsive brand-image" style="background-color: <?= /** @noEscape */ $brand->getSwatchValue() ?>">
                            <?php else: ?>
                                <img class="img-responsive brand-image"
                                     src="<?= /** @noEscape */ $block->helper()->getBrandImageUrl($brand) ?>" alt="">
                            <?php endif; ?>
                        </a>
                    </div>
                <?php endforeach; ?>
            </div>
        </div>
    </div>
<?php endif; ?>
