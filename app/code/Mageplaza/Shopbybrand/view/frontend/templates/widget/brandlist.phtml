/** @var \Mageplaza\Shopbybrand\Block\Widget\Featured $block */

use Magento\Swatches\Model\Swatch;

$timeId = time();
$selectedBrands = $block->getCollection();
$helperData  = $this->helper(\Mageplaza\Shopbybrand\Helper\Data::class);

if (count($selectedBrands) > 1 && $helperData->isEnable()) : ?>
    <?= /** @noEscape */ $block->includeCssLib() ?>
    <div class="block block-brand-feature widget">
        <?php if ($block->getData('show_title')) : ?>
            <div class="block-title">
                <h2 id="block-feature-brand-heading" role="heading"
                        aria-level="2"><?= /** @noEscape */ $block->getTitle() ?></h2>
            </div>
        <?php endif; ?>
        <div class="block-content">
            <div class="owl-carousel owl-theme brand-carousel"
                 id="feature-brand-carousel-<?= /** @noEscape */ $timeId ?>"
                 data-mage-init='{"brandSlider": {}}'>
                <?php foreach ($selectedBrands as $brand) : ?>
                    <div class="relate-content item">
                        <a href="<?= /** @noEscape */ $block->helper()->getBrandUrl($brand) ?>">
                            <?php if ($brand->getSwatchType() == Swatch::SWATCH_TYPE_VISUAL_COLOR): ?>
                                <img class="img-responsive brand-image"
                                     style="background-color: <?= /** @noEscape */ $brand->getSwatchValue() ?>" alt="">
                            <?php else: ?>
                                <img class="img-responsive brand-image"
                                     src="<?= /** @noEscape */ $block->helper()->getBrandImageUrl($brand) ?>" alt="">
                            <?php endif; ?>
                        </a>
                    </div>
                <?php endforeach; ?>
            </div>
        </div>
    </div>
<?php endif; ?>
