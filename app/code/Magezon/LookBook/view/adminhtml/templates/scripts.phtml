<script type="text/javascript">
    require(['jquery'], function($) {
        $('#mgzlookbook_general_enabled').change(function(){
            if($(this).val() == 0) {
                $('.section-config').css('border-color', 'transparent');
            } else {
                $('.section-config').css('border-color', '#ccc');
            }
        });
        if($('#mgzlookbook_general_enabled').val() == 0) {
            $('.section-config').css('border-color', 'transparent');
        }
    })
</script>