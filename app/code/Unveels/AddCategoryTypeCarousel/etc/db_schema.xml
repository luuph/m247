<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="mobikul_carousel" resource="default" engine="innodb" comment="Mobikul Carousel Table">
        <column xsi:type="text" name="categories" nullable="true" comment="Categories"/>
        <column xsi:type="int" name="number_of_products" nullable="false" default="0" comment="Number of Products"/>
        <column xsi:type="text" name="block_title" nullable="true" comment="Block Title"/>
        <column xsi:type="text" name="block_description" nullable="true" comment="Block Description"/>
    </table>
</schema>
