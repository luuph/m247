<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">lookbook_profile_form.lookbook_profile_form_data_source</item>
            <item name="namespace" xsi:type="string">lookbook_profile_form</item>
        </item>
        <item name="label" xsi:type="string" translate="true">General Information</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="save" class="Magezon\LookBook\Block\Adminhtml\Profile\Edit\Button\Save"/>
            <button name="view" class="Magezon\LookBook\Block\Adminhtml\Profile\Edit\Button\View"/>
            <!-- <button name="apply" class="Magezon\LookBook\Block\Adminhtml\Profile\Edit\Button\Apply"/> -->
            <button name="delete" class="Magezon\LookBook\Block\Adminhtml\Profile\Edit\Button\Delete"/>
            <button name="back">
                <url path="*/*/"/>
                <class>back</class>
                <label translate="true">Back</label>
            </button>
        </buttons>
        <namespace>lookbook_profile_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>lookbook_profile_form.lookbook_profile_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="storelocator_store_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">Magezon\LookBook\Ui\DataProvider\Profile\Form\DataProvider</argument>
            <argument name="name" xsi:type="string">lookbook_profile_form_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">profile_id</argument>
            <argument name="requestFieldName" xsi:type="string">profile_id</argument>
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="submit_url" xsi:type="url" path="*/*/save"/>
                </item>
            </argument>
        </argument>
    </dataSource>
    <fieldset name="general">
        <settings>
            <collapsible>true</collapsible>
            <label translate="true">General</label>
            <opened>true</opened>
        </settings>
        <field name="profile_id" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">lookbook</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>profile_id</dataScope>
            </settings>
        </field>
        <field name="is_active" sortOrder="10" formElement="checkbox">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">lookbook</item>
                    <item name="default" xsi:type="number">1</item>
                </item>
            </argument>
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Enable Profile</label>
                <dataScope>is_active</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="title" sortOrder="20" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">lookbook</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Profile Title</label>
                <dataScope>title</dataScope>
            </settings>
        </field>
        <field name="identifier" sortOrder="30">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="component" xsi:type="string">Magezon_Core/js/components/generated-urlkey</item>
                    <item name="mask" xsi:type="string">{{title}}</item>
                    <item name="label" xsi:type="string" translate="true">URL Key</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                        <item name="validate-identifier" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>
        <!-- New try_on_url Field -->
        <field name="try_on_url" sortOrder="40" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">lookbook</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Try On URL</label>
                <dataScope>try_on_url</dataScope>
                <validation>
                    <rule name="validate-url" xsi:type="boolean">false</rule> <!-- optional URL validation -->
                </validation>
                <required>false</required>
            </settings>
        </field>

        <field name="description" sortOrder="50">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="template" xsi:type="string">ui/form/field</item>
                    <item name="wysiwygConfigData" xsi:type="array">
                        <item name="height" xsi:type="string">200px</item>
                    </item>
                    <item name="formElement" xsi:type="string">wysiwyg</item>
                    <item name="dataType" xsi:type="string">string</item>
                    <item name="label" xsi:type="string" translate="true">Description</item>
                    <item name="wysiwyg" xsi:type="boolean">true</item>
                    <item name="rows" xsi:type="number">6</item>
                </item>
            </argument>
        </field>
        <field name="creation_time" sortOrder="94" formElement="date">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">lookbook</item>
                </item>
            </argument>
            <settings>
                <dataType>date</dataType>
                <label translate="true">Creation Time</label>
            </settings>
        </field>
    </fieldset>
    <fieldset name="marker">
        <settings>
            <collapsible>true</collapsible>
            <label translate="true">Marker</label>
            <opened>true</opened>
        </settings>
        <field name="marker" formElement="input" sortOrder="10" class="Magezon\LookBook\Ui\Component\Form\Field\Marker">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="additionalClasses" xsi:type="string">field-marker</item>
                    <item name="component" xsi:type="string">Magezon_LookBook/js/form/element/marker</item>
                </item>
            </argument>
        </field>
        <field name="image" sortOrder="20" formElement="hidden">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">lookbook</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <dataScope>image</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
    </fieldset>
    <fieldset name="display" sortOrder="60">
        <settings>
            <collapsible>true</collapsible>
            <label translate="true">Display Settings</label>
        </settings>
        <field name="storeviews" sortOrder="40" formElement="multiselect" class="Magento\Store\Ui\Component\Form\Field\StoreView">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">block</item>
                    <item name="default" xsi:type="number">0</item>
                </item>
                <item name="options" xsi:type="object">\Magezon\LookBook\Ui\Component\Listing\Columns\Profile\Options</item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>int</dataType>
                <tooltip>
                    <link>https://docs.magento.com/m2/ce/user_guide/configuration/scope.html</link>
                    <description>What is this?</description>
                </tooltip>
                <label translate="true">Store View</label>
                <dataScope>store_id</dataScope>
            </settings>
        </field>
        <field name="layout_type" formElement="select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">page</item>
                    <item name="value" xsi:type="string">default</item>
                    <item name="formElement" xsi:type="string">select</item>
                    <item name="component" xsi:type="string">Magento_Ui/js/form/element/ui-select</item>
                    <item name="elementTmpl" xsi:type="string">ui/grid/filters/elements/ui-select</item>
                    <item name="multiple" xsi:type="boolean">false</item>
                    <item name="disableLabel" xsi:type="boolean">true</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Layout Type</label>
                <dataScope>layout_type</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Magezon\LookBook\Ui\Component\Form\Field\ProfileLayoutType"/>
                    </settings>
                </select>
            </formElements>
        </field>
    </fieldset>
    <fieldset name="design" sortOrder="70">
        <settings>
            <collapsible>true</collapsible>
            <label translate="true">Design Settings</label>
        </settings>
        <field name="page_layout">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Magento\Cms\Model\Page\Source\PageLayout</item>
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Page Layout</item>
                    <item name="formElement" xsi:type="string">select</item>
                    <item name="source" xsi:type="string">page</item>
                    <item name="dataScope" xsi:type="string">page_layout</item>
                    <item name="component" xsi:type="string">Magento_Ui/js/form/element/ui-select</item>
                    <item name="elementTmpl" xsi:type="string">ui/grid/filters/elements/ui-select</item>
                    <item name="multiple" xsi:type="boolean">false</item>
                    <item name="disableLabel" xsi:type="boolean">true</item>
                    <item name="value" xsi:type="string">1column</item>
                </item>
            </argument>
        </field>
        <field name="custom_layout_update_xml">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="template" xsi:type="string">ui/form/field</item>
                    <item name="formElement" xsi:type="string">textarea</item>
                    <item name="sortOrder" xsi:type="number">20</item>
                    <item name="dataType" xsi:type="string">string</item>
                    <item name="label" xsi:type="string" translate="true">Layout Update XML</item>
                    <item name="rows" xsi:type="number">10</item>
                </item>
            </argument>
        </field>
    </fieldset>
    <fieldset name="seo" sortOrder="90">
        <settings>
            <collapsible>true</collapsible>
            <label translate="true">Search Engine Optimization</label>
        </settings>
        <field name="meta_title" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">page_title</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Meta Title</label>
                <dataScope>meta_title</dataScope>
            </settings>
        </field>
        <field name="meta_keywords">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="template" xsi:type="string">ui/form/field</item>
                    <item name="formElement" xsi:type="string">textarea</item>
                    <item name="dataType" xsi:type="string">string</item>
                    <item name="label" xsi:type="string" translate="true">Meta Keywords</item>
                    <item name="rows" xsi:type="number">5</item>
                </item>
            </argument>
        </field>
        <field name="meta_description">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="template" xsi:type="string">ui/form/field</item>
                    <item name="formElement" xsi:type="string">textarea</item>
                    <item name="dataType" xsi:type="string">string</item>
                    <item name="label" xsi:type="string" translate="true">Meta Description</item>
                    <item name="rows" xsi:type="number">5</item>
                </item>
            </argument>
        </field>
    </fieldset>
</form>
