		    			</div>
						<div class="lookbook-profile-product lookbook-profile-product-popup-<?= $marker['popup'] ?> lookbook-profile-not-product">
							<div class="lookbook-profile-marker-desc">
								<p><?= $marker['description'] ?></p>
							</div>
						</div>
					</div>
				<?php } ?>
