<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="bss.giftcard.checkout.cart.giftcard" remove="true"/>
        <referenceBlock name="checkout.cart.coupon" remove="true"/>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template" name="restrict.discount.cart.js" template="Unveels_RestrictDiscounts::restrict-discounts-cart.phtml"/>
            <referenceContainer name="cart.summary">
                <block class="Bss\GiftCard\Block\Cart\GiftCard" name="bss.giftcard.checkout.cart.giftcard.summary" template="cart/giftcard.phtml" after="checkout.cart.summary.title"/>
                <block class="Magento\Checkout\Block\Cart\Coupon" name="checkout.cart.coupon.summary" as="coupon2" template="Unveels_RestrictDiscounts::cart/coupon.phtml" after="checkout.cart.summary.title"/>
            </referenceContainer>
        </referenceContainer>
        <referenceBlock name="checkout.cart.totals">
            <arguments>
                <argument name="jsLayout" xsi:type="array">
                    <item name="components" xsi:type="array">
                        <item name="block-totals" xsi:type="array">
                            <item name="children" xsi:type="array">
                                <item name="before_grandtotal" xsi:type="array">
                                    <item name="children" xsi:type="array">
                                        <item name="giftcard" xsi:type="array">
                                            <item name="component"  xsi:type="string">Bss_GiftCard/js/view/cart/totals/giftcard</item>
                                            <item name="sortOrder" xsi:type="string">25</item>
                                        </item>
                                    </item>
                                </item>
                            </item>
                        </item>
                    </item>
                </argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
