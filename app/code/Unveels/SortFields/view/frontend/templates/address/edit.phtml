        <?php if ($mage_block->getDetectByIp()):?>
        country_flag = "<?= /* @noEscape*/ $mage_block->getCustomerIPDetails();?>";
        <?php endif; ?>

        jQuery(int_phone_input_element).intlTelInput({
            initialCountry: country_flag
        });
        jQuery(int_phone_input_element).removeAttr('placeholder');

        jQuery('#telephone').keyup(function() {
            Smsresetdata();
            var str = jQuery(".selected-flag").attr("title");
            var countrycodeval = str.split('+')[1];
            var mobilelength = jQuery(int_phone_input_element).val().length;
            var mobile = countrycodeval + jQuery(int_phone_input_element).val();

            jQuery("#countryreg").val(countrycodeval);
            var temp = true;
            if (mobile == null || mobile == '') {
                temp = false;
                jQuery(int_phone_input_element).addClass('mage-error');
                $('#smserror').html('<?= /* @noEscape*/ __('This is a required field.') ?>');
            }
            if (!$.isNumeric(mobile) || mobile.substring(0, 1) == '+' || mobile.substring(0, 1) == '-') {
                temp = false;
                jQuery(int_phone_input_element).addClass('mage-error');
                $('#smserror').html(
                    '<?= /* @noEscape*/ __('Make sure, you have entered valid WhatsApp Number.') ?>');
            }
            var countrycode = jQuery(".flag-container > .country-list > .active").attr("data-country-code");
            if(countrycode == undefined || countrycode == "")
            {
                const element = document.querySelector('.iti-flag');
                if (element) {
                    const classList = element.className.split(' '); 
                    countrycode = classList[classList.indexOf('iti-flag') + 1]; 
                }
            }
            $.ajax({
                type: "POST",
                url: '<?= /* @noEscape*/ $block->getUrl('whatsappcountryflag/customer/validatephone')?>',
                data: {
                    'mobile': mobile,
                    'countrycode': countrycode,
                    'mobilelength': mobilelength,
                    'country_id': countrycodeval
                },
                success: function(data) {
                    if (data.validate == true) {
                        $('#smserror').html('<?= /* @noEscape*/ __('') ?>');
                        jQuery('button.action.save.primary[data-action="save-address"]').prop(
                            "disabled", false);
                    } else {
                        if (temp == true) {
                            $('#smserror').html(data.message);
                        }
                        jQuery('button.action.save.primary[data-action="save-address"]').prop(
                            "disabled", true);
                    }
                },
                error: function(data) {
                    $('#smserror').html(
                        '<?= /* @noEscape*/ __('Something went wrong, Try again later.') ?>'
                        );
                }
            });
        });
