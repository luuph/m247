<script>
require([
        'jquery',
        'Magecomp_Whatsappcountryflag/js/intlTelInput.min'
    ],
    function($) {

        $(document).ready(function () {
            let errorDiv = $('<div>', {
                id: 'smserror',
                name: 'smserror',
                generated: 'true',
                class: 'mage-error',
                css: { marginTop: '-15px' }
            });

            $(".field.telephone.required").after(errorDiv); // Insert after the telephone field
        });

        function Smsresetdata() {
            jQuery(int_phone_input_element).removeClass('mage-error');
            jQuery('#smserror').html('');
        }

        function Smstoggeldata(Elementid) {
            jQuery(Elementid).toggle();
        }
        <?php if ($mage_block->isEnabled()): ?>
