type Mutation {
    addToWishlist(
        storeId: Int,
        productId: Int!,
        customerToken: String,
        params: String
    ): AddToWishlist @resolver(class: "Webkul\\MobikulApiGraphQl\\Model\\Resolver\\Catalog\\AddToWishlist") @doc(description: "Add to wishlist request")

    addToCompare(
        storeId: Int,
        productId: Int!,
        customerToken: String               
    ): DefaultResponse @resolver(class: "Webkul\\MobikulApiGraphQl\\Model\\Resolver\\Catalog\\AddToCompare") @doc(description: "Add to compare request")

    removeFromCompare(
        storeId: Int,
