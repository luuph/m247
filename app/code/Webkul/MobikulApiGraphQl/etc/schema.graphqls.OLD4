type CreditView {
    success: Boolean,
    message: String,
    orderId: Int,
    shippingAddress: ShippingAddress,
    billingAddress: BillingAddress,
    shippingMethod: ShippingMethod,
    paymentMethod: PaymentMethod,
    itemList: [InvoiceItemList],
    totals: [InvoiceTotalsData]
}

input reviewRatings {
    ratingId: Int,
    optionId: Int
}

type DeleteAccount {
    success: Boolean,
    message: String,
    otherError: String
}

type UploadBannerPic {
    success: Boolean,
    message: String,
    url: String
}

input cartItemData {
    id: String,
    qty: String
}

input addToCartParams {
    options: [addToCartParamsOptions],
    bundleOption: [addToCartBundleOption],
    superGroup: [addToCartSuperGroup],
    superAttribute: [addToCartSuperAttribute],
    links: [String]
}

input addToCartParamsOptions {
    id: String,
    value: [String]
}

input addToCartBundleOption {
    id: String,
    value: String,
    qty: String
}

input addToCartSuperGroup {
    id: String,
    value: String
}

input addToCartSuperAttribute {
    id: String,
    value: String
}

input shippingDataInput {
    addressId: String,
    newAddress: newAddressInput,
    sameAsShipping: String
}

input newAddressInput {
    saveInAddressBook: String,
    email: String,
    fax: String,
    city: String,
    region: String,
    prefix: String,
    suffix: String,
    street: [String],
    company: String,
    lastName: String,
    postcode: String,
    region_id: String,
    firstName: String,
    telephone: String,
    middleName: String,
    country_id: String,
    address_title: String,
    custom_attributes: [CustomAttributeInput]
}

input saveAddressDataInput {
    default_billing: String,
    default_shipping: String,
    fax: String,
    city: String,
    region: String,
    prefix: String,
    suffix: String,
    street: [String],
    company: String,
    lastName: String,
    postcode: String,
    region_id: String,
    firstName: String,
    telephone: String,
    middleName: String,
    country_id: String,
    address_title: String,
    custom_attributes: [CustomAttributeInput]
}

input CustomAttributeInput {
    attribute_code: String!
    value: String!
}

type ShareWishlist {
    success: Boolean,
    message: String,
    sentTo: String
}

type GuestView {
    success: Boolean,
    message: String,
    orderData: GuestOrderData
}

type GuestOrderData {
    itemList: [GuestItemList],
    totals: [OrderItemTotals],
    orderInfo: [OrderInfo]
}

type GuestItemList {
    name: String,
    sku: String,
    price: String,
    qty: Int,
    subTotal: String
}

type OrderInfo {
    shippingAddress: String,
    shippingMethod: String,
    billingAddress: String,
    paymentMethod: String
}

type GuestReOrder {
    success: Boolean,
    message: String,
    quoteId: String,
    cartCount: Int
}

type AllToCart {
    success: Boolean,
    message: String,
    warning: Boolean,
    cartCount: Int
}

type SearchTermList {
    success: Boolean,
    message: String,
    termList: [TermList]
}

type TermList {
    term: String,
    ratio: Int
}

type SearchSuggestion {
    success: Boolean,
    message: String,
    suggestProductArray: SuggestProductArray
}

type SuggestProductArray {
    products: [SuggestProduct],
    tags: [Suggestionproducttags]
}

type Suggestionproducttags {
    label: String,
    count: Int
}

