        <column xsi:type="int" name="id" unsigned="true" nullable="false" padding="10" identity="true" comment="Id"/>
        <column xsi:type="text" name="filename" nullable="true" comment="Filename"/>
        <column xsi:type="int" name="status" unsigned="true" nullable="false" identity="false" default="0" comment="Status"/>
        <column xsi:type="text" name="type" nullable="true" comment="Type"/>
        <column xsi:type="int" name="pro_cat_id" unsigned="true" nullable="false" identity="false" default="0" comment="Product Category Id"/>
        <column xsi:type="text" name="store_id" nullable="false" comment="Store ID"/>
        <column xsi:type="int" name="sort_order" unsigned="true" nullable="false" default="0" comment="Sort Order"/>
