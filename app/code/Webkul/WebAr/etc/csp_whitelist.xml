<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <policy id="connect-src">
           <values>
                <value id="data" type="host">'self' data:</value>
                <value id="data" type="host">'unsafe-inline' data:</value>
                 <value id="blob" type="host">'self' blob:</value>
                <value id="blob" type="host">'unsafe-inline' blob:</value>
            </values>       
        </policy>
        <policy id="script-src">
            <values>
                <value id="wasm-eval" type="host">'self' data:</value>
                <value id="model-viewer-lib-base-url" type="host">https://ajax.googleapis.com/</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
