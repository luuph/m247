<?php if (($imageCount == 0 || ($imageCount == 1 && $isPlaceHolderImg))
&& $modelUrl != "" && $display): ?>
    <div class="load-webar-model">
        <!-- Use it like any other HTML element -->
        <model-viewer data-js-focus-visible 
            src="<?= $block->escapeHtmlAttr($modelUrl) ?>"
            alt="A 3D model of an product" camera-controls  
            camera-orbit="33deg 67deg auto" 
            ar 
            <?php if ($productType == "configurable" || $product->hasOptions()) {?>
                ar-modes="webxr quick-look"
            <?php  } else { ?>
                ar-modes="scene-viewer webxr quick-look"
                <?php
            }
            ?>

            <?php if ($cameraAttrs["autoRotate"] == 1) {?>
                auto-rotate 
                <?php if ($cameraAttrs["autoRotateDelay"] != '') { ?>
                auto-rotate-delay="<?= $block->escapeHtmlAttr($cameraAttrs["autoRotateDelay"]) ?>" 
            <?php   }
            }
            ?>

            <?php if ($cameraAttrs["disableZoom"] == 1) {?>
                disable-zoom 
            <?php }?>
            <?php if ($cameraAttrs["disableTap"] == 1) {?>
                disable-tap 
            <?php }?>

            <?php if ($cameraAttrs["touchAction"] != '') {?>
                touch-action="<?= $block->escapeHtmlAttr(strtolower($cameraAttrs["touchAction"])) ?>" 
            <?php }?>

            <?php if ($cameraAttrs["interpolationDecay"] != '') {?>
                interpolation-decay="<?=$block->escapeHtmlAttr($cameraAttrs["interpolationDecay"]) ?>" 
            <?php }?>

            <?php if ($lightAttrs["modelShadowIntensity"] != "-1"
                && $lightAttrs["modelShadowIntensity"] != "") {?>
                shadow-intensity="<?= $block->escapeHtmlAttr($lightAttrs["modelShadowIntensity"]) ?>" 
            <?php }?>
            <?php if ($lightAttrs["modelExposure"] != "-1" && $lightAttrs["modelExposure"] != "") {?>
                exposure="<?= $block->escapeHtmlAttr($lightAttrs["modelExposure"]) ?>" 
            <?php }?>
            <?php if ($lightAttrs["shadowSoftness"] != "-1" && $lightAttrs["shadowSoftness"] != "") {?>
                shadow-softness="<?= $block->escapeHtmlAttr($lightAttrs["shadowSoftness"]) ?>" 
            <?php }?>

            <?php if ($lightAttrs["envImg"] != "" && $lightAttrs["envImg"] != 'envurl'
                && $lightAttrs["applyEnvImg"] == 1) {?>
                environment-image="<?= $block->escapeHtmlAttr($lightAttrs["envImg"]) ?>" 
            <?php } elseif ($lightAttrs["envImg"] == 'envurl' && $lightAttrs["envImgUrl"] != ''
                && $lightAttrs["applyEnvImg"] == 1) {?>
                environment-image="<?= $block->escapeHtmlAttr($lightAttrs["envImgUrl"]) ?>" 
            <?php }?>

            <?php if ($imagesConfig["skyImgDirPath"] != '' && $lightAttrs["applySkyImg"] == 1) {?>
                skybox-image="<?= $block->escapeHtmlAttr($imagesConfig["skyImgDirPath"]) ?>" 
            <?php }?>
            
            <?php if ($loading != '') {?>
                loading="<?= $block->escapeHtmlAttr($loading) ?>" 
                reveal="auto" 
            <?php }?>
            <?php if ($imagesConfig["posterImgDirPath"] != '') {?>
                poster="<?= $block->escapeHtmlAttr($imagesConfig["posterImgDirPath"]) ?>" 
            <?php }?>
            
            <?php if (!empty($iosModelUrl)) {?>
            ios-src="<?= $block->escapeHtmlAttr($iosModelUrl) ?>" 
            <?php }?>>

            <!--Show Custom AR Button-START-->
            <?php if ($btnConfig["showCustomButton"]) {?>
                <button slot="ar-button" id="ar-button">
                    <?= $block->escapeHtml($btnConfig["configButtonText"]) ?>
                </button>
            <?php } ?>
            <!--Show Custom AR Button-ENDS-->

            <!--Show Associated Products's GLB Models-START-->
            <?php if (!empty($associatedProducts) && $showSeperateGlb) {
                foreach ($associatedProducts as $assProId => $assPro) {
                    $thumbNail = $assPro["thumbnail"] ?? "";
                    if ($imagesConfig["posterImgDirPath"] != '' && $thumbNail == "") {
                        $thumbNail = $imagesConfig["posterImgDirPath"] ?? "";
                    }
                    ?>
                <div id="wk-slide-<?=$block->escapeHtmlAttr($assProId) ?>"
                    class="wk-slide"
                    data-model="<?= $block->escapeHtmlAttr($assPro["modelUrl"] ?? '') ?>"
                    data-thumb="<?= $block->escapeHtmlAttr($thumbNail) ?>"
                    data-ios-model="<?= $block->escapeHtmlAttr($assPro["iosModelUrl"] ?? '') ?>"
                    data-product-id="<?= $block->escapeHtmlAttr($assProId) ?>">
                </div>
                    <?php
                }
            } ?>
            <!--Show Associated Products's GLB Models-ENDS-->

        </model-viewer>
    </div>
<?php endif; ?>

